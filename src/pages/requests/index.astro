---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Request a new novel — preview" noindex description="Preview of Hunmeng novel request submission. Requests are not open yet.">
  <main id="main" class="page-shell request-preview-page">
    <header class="request-intro">
      <span class="request-eyebrow">Hunmeng · Community</span>
      <h1>Request a new novel</h1>
      <p>Help shape the library: suggest a new story or another source for a story already listed.</p>
      <p class="request-warning" role="status"><strong>Preview only:</strong> submissions are not enabled. Checking a link on this page never sends it to Hunmeng.</p>
    </header>

    <div class="request-layout">
      <section class="request-card request-form-card" aria-labelledby="request-form-heading">
        <h2 id="request-form-heading">Share a source link</h2>
        <p>Paste the original work's public HTTPS URL. We'll check the format locally; source recognition and duplicate detection will run on the server after launch.</p>
        <form id="novel-request-preview-form" novalidate>
          <fieldset class="request-options">
            <legend>What would you like to request?</legend>
            <label><input type="radio" name="requestType" value="novel" checked /> New novel</label>
            <label><input type="radio" name="requestType" value="source" /> Another source</label>
          </fieldset>
          <label class="request-label" for="novel-source-url">Novel URL</label>
          <input id="novel-source-url" name="url" type="url" inputmode="url" autocomplete="url" spellcheck="false" maxlength="2048" placeholder="https://example.org/book/123" required aria-describedby="request-url-help" />
          <p class="request-hint" id="request-url-help">Use a complete HTTPS URL. A valid address does not mean the source is supported or that publication rights are granted.</p>
          <div class="request-action">
            <button class="button" type="submit">Check link format</button>
            <span class="request-small-status">No account or payment required for this local preview</span>
          </div>
          <p class="request-result" id="novel-request-preview-result" role="status" aria-live="polite">No request has been submitted.</p>
        </form>
      </section>

      <aside class="request-side" aria-label="Request information">
        <section class="request-card" aria-labelledby="request-limit-heading">
          <div class="request-side-title"><h2 id="request-limit-heading">Request allowance</h2><span class="request-pill">Not active</span></div>
          <p>Weekly limits and voting will be introduced after authenticated requests and anti-abuse checks are ready.</p>
          <div class="request-meter" role="img" aria-label="Request usage is not available"><span></span></div>
          <p class="request-hint">We won't show invented usage counts or charge for requests that have not been sent.</p>
        </section>
        <section class="request-card" aria-labelledby="request-sources-heading">
          <h2 id="request-sources-heading">Supported sources</h2>
          <p>Source integrations are being reviewed. No external website is officially supported by this preview.</p>
          <p class="request-hint">Only sources with an approved adapter and permitted metadata access will appear here.</p>
        </section>
      </aside>
    </div>

    <section class="request-card request-steps" aria-labelledby="request-steps-heading">
      <h2 id="request-steps-heading">How requests will work</h2>
      <ol>
        <li><strong>Paste a link.</strong> The source will be checked against a supported-site registry.</li>
        <li><strong>Check for duplicates.</strong> Alternate titles, authors, original IDs and available chapter evidence will be compared.</li>
        <li><strong>Review.</strong> A moderator will confirm uncertain matches and rights before any public publication.</li>
        <li><strong>Follow progress.</strong> Signed-in members will be able to view statuses and request history.</li>
      </ol>
    </section>
    <section class="request-card request-history" aria-labelledby="request-history-heading">
      <div class="request-history-heading"><h2 id="request-history-heading">Your requests</h2><span class="request-pill">Coming later</span></div>
      <p>No requests are loaded. Account-specific history will be shown only after the server-backed feature is released.</p>
      <a href="/catalog/">Browse novels already in the catalog</a>
    </section>
  </main>
</Layout>

<style>
.request-preview-page {padding-top:38px; padding-bottom:80px; --request-edge:var(--line);--request-soft:var(--soft);}
.request-intro {max-width:820px; margin-bottom:28px;}
.request-eyebrow {display:block; font-size:.73rem; font-weight:800; text-transform:uppercase; letter-spacing:.14em; color:var(--accent); margin-bottom:10px;}
.request-intro h1 {font-size:clamp(2rem,5vw,3rem); margin-bottom:12px;}
.request-intro>p:not(.request-warning){max-width:65ch;color:var(--muted);}
.request-warning {margin-top:18px; padding:14px 16px;border:1px solid var(--request-edge);border-left:4px solid var(--accent);border-radius:10px;background:var(--request-soft);font-size:.92rem;}
.request-layout {display:grid;grid-template-columns:minmax(0,1.65fr) minmax(255px,1fr);gap:20px;align-items:start;}
.request-side {display:grid;gap:20px;min-width:0;}
.request-card {min-width:0;padding:25px;border:1px solid var(--request-edge);border-radius:18px;background:var(--surface);box-shadow:0 6px 28px #00000007;}
.request-card h2 {font-size:1.34rem;margin-bottom:10px;}
.request-card p {color:var(--muted);font-size:.93rem;line-height:1.65;}
.request-card p+p{margin-top:10px;}
.request-form-card>p{margin-bottom:22px;}
.request-options {padding:0;border:0;margin:0 0 18px;display:flex;flex-wrap:wrap;gap:10px;}
.request-options legend {display:block;width:100%;font-weight:700;font-size:.875rem;margin-bottom:9px;}
.request-options label {display:flex;align-items:center;gap:9px;border:1px solid var(--request-edge);border-radius:10px;padding:10px 13px;cursor:pointer;font-size:.92rem;}
.request-options label:has(input:checked) {background:var(--request-soft);border-color:var(--accent);}
.request-label {display:block;font-weight:700;font-size:.9rem;margin-bottom:8px;}
#novel-source-url {width:100%;min-height:48px;padding:12px;border-radius:10px;border:1px solid var(--request-edge);background:var(--bg);color:var(--ink);font-size:1rem;}
#novel-source-url:focus-visible {outline:3px solid var(--accent);outline-offset:2px;}
.request-hint {margin-top:8px!important;font-size:.8rem!important;}
.request-action {margin-top:20px;display:flex;gap:14px;align-items:center;flex-wrap:wrap;}
.request-action button {min-height:46px;}
.request-small-status {font-size:.76rem;color:var(--muted);}
.request-result {margin-top:15px!important;padding:13px;border:1px dashed var(--request-edge);border-radius:10px;background:var(--request-soft);color:var(--ink)!important;overflow-wrap:anywhere;}
.request-result[data-valid="false"]{border-color:#b2604c;}
.request-result[data-valid="true"]{border-color:var(--accent);}
.request-side-title,.request-history-heading {display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;}
.request-side-title h2,.request-history-heading h2 {margin-bottom:0;}
.request-side-title+p {margin-top:12px;}
.request-pill {font-size:.75rem;border:1px solid var(--request-edge);border-radius:100px;padding:4px 9px;background:var(--request-soft);color:var(--muted);white-space:nowrap;}
.request-meter {height:9px;border-radius:20px;background:var(--request-soft);margin-top:18px;overflow:hidden;}
.request-meter>span {display:block;height:100%;width:0;}
.request-steps,.request-history {margin-top:20px;}
.request-steps ol {margin:13px 0 0;padding-left:23px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px 28px;}
.request-steps li {color:var(--muted);font-size:.91rem;line-height:1.6;}
.request-steps strong {color:var(--ink);}
.request-history a {display:inline-flex;margin-top:16px;text-decoration:underline;text-underline-offset:3px;color:var(--accent);font-weight:700;}
@media(max-width:800px){.request-layout{grid-template-columns:1fr}.request-steps ol{grid-template-columns:1fr}}
@media(max-width:480px){.request-preview-page{padding:22px 16px 60px}.request-card{padding:18px;border-radius:14px}.request-options{display:grid;grid-template-columns:1fr 1fr;gap:8px}.request-options label{font-size:.82rem;padding:9px}.request-action{align-items:stretch}.request-action button{width:100%}.request-small-status{display:block;text-align:center;width:100%}}
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#novel-request-preview-form');
  const urlField = document.querySelector<HTMLInputElement>('#novel-source-url');
  const result = document.querySelector<HTMLElement>('#novel-request-preview-result');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    if (!urlField || !result) return;
    try {
      const url = new URL(urlField.value.trim());
      if (url.protocol !== 'https:' || url.username || url.password || url.port || url.hostname === 'localhost' || url.hostname.endsWith('.localhost'))
        throw new Error('invalid');
      result.dataset.valid = 'true';
      result.textContent = 'The URL format looks valid. No data was sent. Source support, duplicate detection and submission will be available after launch.';
    } catch {
      result.dataset.valid = 'false';
      result.textContent = 'Enter a full HTTPS novel URL without a username, password or custom port. No request was sent.';
    }
  });
</script>
