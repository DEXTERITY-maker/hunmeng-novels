---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---
<Layout title="Вход и регистрация" noindex description="Войдите в Хунмэнг или создайте аккаунт читателя по email и паролю.">
  <main id="main" class="page-shell account-page reader-account-page">
    <header class="page-heading">
      <p class="home-section-kicker">ХУНМЭНГ · ВАШ АККАУНТ</p>
      <h1>Вход и регистрация</h1>
      <p>Читать новеллы можно и без аккаунта.</p>
    </header>
    {site.features.accounts ? (
      <>
        <p class="notice" id="account-status" role="status" aria-live="polite">Проверяем сессию…</p>
        <section id="auth-fields" class="account-card" aria-label="Авторизация читателя">
          <div class="auth-mode-switch" role="group" aria-label="Выберите действие">
            <button type="button" class="button" data-auth-mode="signin" aria-pressed="true">Войти</button>
            <button type="button" class="button secondary" data-auth-mode="signup" aria-pressed="false">Зарегистрироваться</button>
          </div>
          <form id="auth-form" method="post" action="/account/">
            <fieldset id="reader-auth-fields" disabled>
              <label>Email
                <input name="email" type="email" autocomplete="username" required maxlength="254" />
              </label>
              <label>Пароль
                <input name="password" type="password" autocomplete="current-password" required />
              </label>
              <label id="confirm-password-label" hidden>Повторите пароль
                <input name="confirmPassword" type="password" autocomplete="new-password" disabled />
              </label>
              <p class="fine" id="signup-hint" hidden>От 8 символов. После регистрации подтвердите email по ссылке из письма. Регистрация не даёт доступа к редакции.</p>
              <button class="button" type="submit" id="reader-auth-submit">Войти</button>
            </fieldset>
          </form>
          <p class="fine">Для аккаунта используется ваш email. Подробнее — в <a href="/rules/">правилах и информации о данных</a>.</p>
        </section>
        <section id="auth-logged-in" class="account-card" hidden aria-label="Ваш аккаунт">
          <h2>Вы вошли в Хунмэнг</h2>
          <p id="account-email"></p>
          <p>Библиотека и место остановки сохраняются на этом устройстве. Синхронизация пока выключена.</p>
          <div class="account-actions">
            <a href="/library/" class="button">Открыть библиотеку</a>
            <button type="button" id="account-signout" class="button secondary">Выйти из аккаунта</button>
          </div>
        </section>
        <noscript><p class="notice">Для регистрации и входа включите JavaScript. Новеллы можно читать без входа.</p></noscript>
      </>
    ) : (
      <p class="notice">Аккаунты читателей временно недоступны. Библиотека работает локально.</p>
    )}
  </main>
  <script>
    import { site } from '../config/site';
    if (site.features.accounts) void import('../scripts/account').then(({ initAccount }) => initAccount());
  </script>
</Layout>
