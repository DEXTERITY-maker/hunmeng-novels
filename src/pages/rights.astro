---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import { contactChannels } from '../lib/contacts';
const channels = contactChannels(site.contacts, true);
---

<Layout title="Rights holders" description="Translation publishing requirements and information for authors and rights holders.">
  <main id="main" class="page-shell prose-page">
    <a class="back-link" href="/">
      ← Home
    </a>
    <h1>Rights holders</h1>
    <p>
      Publishing a translation on Hunmeng requires verified permission to translate and publish the text. Cover permissions are checked separately. Public availability does not replace permission from the rights holder.
    </p>
    <p>The demo stories were written specifically for this project and are not translations of other authors' works.</p>
    <h2>Rights requests</h2>
    {channels.length ? (
      <ul class="contact-channels">{channels.map(channel => (
        <li>{channel.label}: <a href={channel.href} rel="noopener noreferrer">{channel.value}</a></li>
      ))}</ul>
    ) : (
      <p class="notice">A contact channel for rights holders has not been published yet. This page cannot receive or send requests.</p>
    )}
    <p>Please include the following:</p>
    <ul>
      <li>The work's title and the addresses of the pages in question.</li>
      <li>Your name or organization and a way to contact you.</li>
      <li>Information verifying your authorship or authority to act for the rights holder.</li>
      <li>A description of the issue and requested action: attribution, correction, or removal.</li>
    </ul>
    <p>Do not post documents containing personal information in comments or public discussions. New translations may be published only after permissions are verified and editorial approval is given.</p>
  </main>
</Layout>
