---
import Layout from '../../layouts/Layout.astro';
import '../../styles/v3-editorial.css';
import '../../styles/v3-admin-editorial.css';
const editorial = import.meta.env.HUNMENG_V2_PUBLIC === '1';
---
<Layout title="Editorial sign-in" noindex description="Sign in for Hunmeng administrators and editors." bodyClass={editorial ? "hm-editorial-site" : undefined}>
  {editorial && (
    <nav class="v3-primary-nav v3-admin-nav" aria-label="Reading room navigation">
      <a href="/">Home</a>
      <a href="/catalog/">Books</a>
      <a href="/news/">Articles</a>
      <a href="/#v3-collections">Collections</a>
      <a href="/library/">My library</a>
      <a href="/about/">About</a>
    </nav>
  )}
  <main id="main" class="page-shell admin-login-page v3-admin-page v3-admin-login-page">
    <a class="back-link" href="/">← Home</a>
    <header class="page-heading">
      <h1>Editorial sign-in</h1>
      <p>For administrators and editors who have been granted access.</p>
    </header>
    <p id="admin-login-status" class="notice" role="status" aria-live="polite">Checking your session…</p>
    <form id="admin-login-form" class="account-card" method="post" action="/admin/login/">
      <fieldset id="admin-login-fields" disabled>
        <label>Email
          <input name="email" type="email" autocomplete="username" required maxlength="254" />
        </label>
        <label>Password
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button class="button" type="submit">Editorial sign-in</button>
      </fieldset>
    </form>
    <p class="fine">Staff cannot register on this site. The project owner grants access.</p>
    <noscript><p class="notice">Enable JavaScript to sign in securely. You can read novels without signing in.</p></noscript>
  </main>
  <script>
    import { initAdminLogin } from '../../scripts/admin-login';
    void initAdminLogin();
  </script>
</Layout>
