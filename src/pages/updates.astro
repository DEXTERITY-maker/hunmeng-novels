---
import Layout from '../layouts/Layout.astro';
import { getLibrary, dateLabel } from '../lib/content';
import { getLatestChapters } from '../lib/updates';
import '../styles/v3-editorial.css';
import '../styles/v3-updates-utility.css';
const editorial = import.meta.env.HUNMENG_V2_PUBLIC === '1';

const chapters = getLatestChapters(await getLibrary());
---

<Layout
  title="All chapter updates"
  description="All recently published Hunmeng chapters, with the newest first."
  bodyClass={editorial ? 'hm-editorial-site' : undefined}
>
  {editorial && (
    <nav class="v3-primary-nav v3-utility-nav" aria-label="Reading room navigation">
      <a href="/">Home</a>
      <a href="/catalog/">Books</a>
      <a href="/news/">Articles</a>
      <a href="/#v3-collections">Collections</a>
      <a href="/library/">My library</a>
      <a href="/about/">About</a>
    </nav>
  )}
  <main id="main" class="page-shell home-page updates-page v3-updates-page">
    <a class="back-link" href="/">← Home</a>
    <header class="page-heading">
      <h1>All updates</h1>
      <p>All published chapters, newest first.</p>
    </header>
    {chapters.length ? (
      <ol class="home-chapter-grid">
        {chapters.map((chapter) => (
          <li>
            <a class="home-chapter-link" href={chapter.url}>
              <img
                src={chapter.cover}
                alt=""
                width="60"
                height="88"
                loading="lazy"
                decoding="async"
              />
              <span class="home-chapter-info">
                <span class="home-chapter-novel">{chapter.novel}</span>
                <strong>Chapter {chapter.number}. {chapter.title}</strong>
                <time datetime={chapter.date}>{dateLabel(chapter.date)}</time>
              </span>
              <span class="home-chapter-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="home-section-empty">No chapters have been published yet.</p>
    )}
  </main>
</Layout>
