---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CompactNovelCard from '../components/CompactNovelCard.astro';
import ContinueReading from '../components/ContinueReading.astro';
import { getLibrary, dateLabel, chapterCount } from '../lib/content';
import { getLatestChapters } from '../lib/updates';
import NewsCard from '../components/NewsCard.astro';
import { getNews } from '../lib/news';

const novels = await getLibrary();
const latestNews = (await getNews()).slice(0, 3);
const newNovels = novels
  .filter((n) => !!n.addedAt)
  .sort((a, b) => b.addedAt!.localeCompare(a.addedAt!) || b.updatedAt.localeCompare(a.updatedAt))
  .slice(0, 12);
const updates = getLatestChapters(novels).slice(0, 4);
const popular = novels
  .filter((n) => typeof n.views === 'number' && n.views > 0)
  .sort((a, b) => (b.views ?? 0) - (a.views ?? 0))
  .slice(0, 5);
const recommendations = [...novels]
  .sort((a, b) => b.chapterCount - a.chapterCount || b.updatedAt.localeCompare(a.updatedAt))
  .slice(0, 4);
const viewsLabel = new Intl.NumberFormat('en-US');
---

<Layout
  title="Web novels: new stories and latest chapters"
  description="Hunmeng — read web novels in English. Discover new stories, fresh chapters, and a comfortable reading experience."
>
  <main id="main" class="page-shell home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-copy">
        <div class="home-hero-content">
          <p class="home-eyebrow"><span class="hero-eyebrow-mark" aria-hidden="true">✦</span> HUNMENG READING ROOM</p>
          <h1 id="home-title">Stories worth <em>coming back to.</em></h1>
          <p class="home-hero-description">A quiet place for extraordinary worlds. Find your next novel, pick up where you left off, and make every chapter your own.</p>
          <form class="home-search" role="search" action="/catalog/" method="get">
            <label class="home-sr-only" for="home-search-input">Search novels</label>
            <span class="home-search-symbol"><Icon name="search" size={21} /></span>
            <input id="home-search-input" type="search" name="search" placeholder="Search stories or authors" autocomplete="off" required />
            <button class="button" type="submit">Search <Icon name="arrow" size={17} /></button>
          </form>
          <nav class="home-discover" aria-label="Explore the library">
            <span>Explore by</span>
            <a href="/genres/">Genres <Icon name="arrow" size={15} /></a>
            <a href="/tags/">Tags <Icon name="arrow" size={15} /></a>
            <a href="/catalog/">All novels <Icon name="arrow" size={15} /></a>
          </nav>
        </div>
        {recommendations[0] && (
          <a class="home-hero-feature" href={recommendations[0].url} aria-label={'Discover featured novel: ' + recommendations[0].title}>
            <div class="home-feature-top">
              <span class="home-feature-kicker"><span aria-hidden="true">✧</span> EDITOR'S SHELF</span>
              <span class="home-feature-count">{chapterCount(recommendations[0].chapterCount)}</span>
            </div>
            <div class="home-feature-visual">
              <span class="home-feature-cover">
                <img src={recommendations[0].cover} alt="" width="250" height="375" fetchpriority="high" decoding="async" />
              </span>
            </div>
            <div class="home-feature-details">
              <p>{recommendations[0].genres.slice(0, 2).join(' · ')}</p>
              <h2>{recommendations[0].title}</h2>
              <span class="home-feature-author">By {recommendations[0].author}</span>
              <span class="home-feature-cta">Discover this story <Icon name="arrow" size={17} /></span>
            </div>
          </a>
        )}
      </div>
    </section>

    <ContinueReading />

    <section id="new-novels" class="section home-section" aria-labelledby="new-title">
      <div class="section-heading home-section-heading">
        <div>
          <h2 id="new-title">New novels</h2>
        </div>
        <a href="/catalog/">Full catalog <span aria-hidden="true">→</span></a>
      </div>
      {newNovels.length ? (
        <div class="home-cover-grid">
          {newNovels.map((n) => <CompactNovelCard novel={n} />)}
        </div>
      ) : (
        <p class="home-section-empty">New stories will appear here soon.</p>
      )}
    </section>

    <div class="home-editorial-columns">
    <section id="latest-chapters" class="section home-section" aria-labelledby="updates-title">
      <div class="section-heading home-section-heading">
        <div>
          <h2 id="updates-title">Latest chapters</h2>
        </div>
        <a href="/updates/">All updates →</a>
      </div>
      {updates.length ? (
        <ol class="home-chapter-grid">
          {updates.map((u) => (
            <li>
              <a class="home-chapter-link" href={u.url}>
                <img src={u.cover} alt="" width="60" height="88" loading="lazy" decoding="async" />
                <span class="home-chapter-info">
                  <span class="home-chapter-novel">{u.novel}</span>
                  <strong>Chapter {u.number}. {u.title}</strong>
                  <time datetime={u.date}>{dateLabel(u.date)}</time>
                </span>
                <span class="home-chapter-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="home-section-empty">Published chapters will appear here soon.</p>
      )}
      <a class="home-updates-button" href="/updates/">
        All updates <span aria-hidden="true">→</span>
      </a>
    </section>

    <section id="latest-news" class="section home-section latest-news-section" aria-labelledby="latest-news-title">
      <div class="section-heading home-section-heading">
        <div>
          <h2 id="latest-news-title">Latest news</h2>
        </div>
        <a href="/news/">View all <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-news-list">
        {latestNews.map((post) => <NewsCard post={post} compact />)}
      </div>
    </section>

    </div>
    {popular.length > 0 && (
    <section id="popular-novels" class="section home-section" aria-labelledby="popular-title">
      <div class="section-heading home-section-heading">
        <div>
          <h2 id="popular-title">Popular</h2>
        </div>
        <a href="/catalog/">Browse catalog <span aria-hidden="true">→</span></a>
      </div>
      <ol class="home-popular-list">
        {popular.map((n, i) => (
          <li>
            <span class="home-rank">{String(i + 1).padStart(2, '0')}</span>
            <a href={n.url} class="home-popular-book">
              <img src={n.cover} alt="" width="52" height="76" loading="lazy" decoding="async" />
              <span>
                <strong>{n.title}</strong>
                <small>{chapterCount(n.chapterCount)} · {n.genres[0]}</small>
              </span>
            </a>
            <span class="home-views">{viewsLabel.format(n.views ?? 0)} views</span>
          </li>
        ))}
      </ol>
    </section>
    )}

    <section id="recommended-novels" class="section home-section" aria-labelledby="recommended-title">
      <div class="section-heading home-section-heading">
        <div>
          <h2 id="recommended-title">Recommended reads</h2>
        </div>
        <a href="/catalog/">Browse catalog <span aria-hidden="true">→</span></a>
      </div>
      <p class="home-recommendation-note">A few stories to get you started.</p>
      {recommendations.length ? (
        <div class="home-recommendation-grid">
          {recommendations.map((n) => (
            <article class="home-recommendation-card">
              <a href={n.url} class="home-recommendation-cover" aria-label={'Open “' + n.title + '”'}>
                <img src={n.cover} alt="" width="115" height="168" loading="lazy" decoding="async" />
              </a>
              <div>
                <p class="genre-line">{n.genres.join(' · ')}</p>
                <h3><a href={n.url}>{n.title}</a></h3>
                <p class="home-recommendation-description">{n.description}</p>
                <span class="fine">{chapterCount(n.chapterCount)} · {n.translationStatus}</span>
                <a class="home-recommendation-action" href={n.url}>Read novel <Icon name="arrow" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="home-section-empty">Recommendations will appear when novels are available.</p>
      )}
    </section>
  </main>
  <script>
    import { initPersonal } from '../scripts/personal';
    void initPersonal();
  </script>
</Layout>
