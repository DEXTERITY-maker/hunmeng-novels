---
import Layout from '../layouts/Layout.astro';
import { shelves, site } from '../config/site';
---

<Layout title="My library" noindex>
  <main id="main" class="page-shell library-page">
    <div class="page-heading">
      <h1>Library</h1>
      <p>Your stories and reading progress are saved on this device.</p>
    </div>
    <div class="shelf-tabs" role="group" aria-label="Shelves">
      {Object.entries(shelves).map(([value, label], i) => (
        <button
          class="shelf-tab"
          type="button"
          data-shelf-tab={value}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {label}
          <span data-shelf-count={value}>0</span>
        </button>
      ))}
    </div>
    <p id="library-count" role="status" aria-live="polite"></p>
    <div id="library-list" class="library-list"></div>
    <p id="library-empty" class="empty-state">
      This shelf is empty.
      <br />
      <a href="/catalog/">Find a novel in the catalog →</a>
    </p>
    <p class="fine storage-explanation">
      Your library and reading progress are saved only in this browser, without being sent to a server.
      Cross-device sync is disabled, including after signing in. Keep this site's browser data to preserve your library.
      {site.features.accounts && <> <a href="/account/">Your account →</a></>}
    </p>
    <noscript>
      <p class="notice">
        Your local library requires JavaScript. The catalog and chapters are available without it.
      </p>
    </noscript>
  </main>
  <script>
    import { initLibrary } from '../scripts/library';
    void initLibrary();
  </script>
</Layout>
