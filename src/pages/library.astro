---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { shelves, site } from '../config/site';
---

<Layout title="My library" noindex>
  <main id="main" class="page-shell library-page">
    <header class="page-heading landscape-banner library-hero">
      <div class="library-hero-copy"><p class="eyebrow">Your own reading corner</p><h1>Library</h1>
      <p>Your stories and reading progress are saved on this device.</p></div>
    </header>
    <div class="shelf-tabs" role="group" aria-label="Shelves">
      {Object.entries(shelves).map(([value, label], i) => (
        <button
          class="shelf-tab"
          type="button"
          data-shelf-tab={value}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <Icon name={(["book", "clock", "check", "ban"] as const)[i]} size={26} />
          <strong>{label}</strong>
          <span data-shelf-count={value}>0</span>
          <Icon name="chevron" size={18} />
        </button>
      ))}
    </div>
    <p id="library-count" role="status" aria-live="polite"></p>
    <div id="library-list" class="library-list"></div>
    <div id="library-empty" class="empty-state library-empty">
      <img src="/images/library-empty.webp" width="300" height="200" alt="" loading="lazy" />
      <h2>This shelf is empty.</h2><p>Start a new story from our catalog and begin your reading journey.</p>
      <a class="button" href="/catalog/">Find a novel in the catalog <Icon name="arrow" size={18} /></a>
    </div>
    <p class="fine storage-explanation"><Icon name="info" size={24} /> <span>
      Your library and progress are saved on this device. Signed-in readers can optionally enable cross-device sync in their account.
      Guest reading is never uploaded. Keep this site's browser data to preserve any unsynced progress.
      {site.features.accounts && <> <a href="/account/">Your account →</a></>}
      </span></p>
    <noscript>
      <p class="notice">
        Your local library requires JavaScript. The catalog and chapters are available without it.
      </p>
    </noscript>
  </main>
  <script>
    import { initLibrary } from '../scripts/library';
    void initLibrary();
  </script>
</Layout>
