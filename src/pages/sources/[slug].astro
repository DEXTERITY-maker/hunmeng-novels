---
import Layout from '../../layouts/Layout.astro';
import { externalNovels } from '../../data/external-novels';
import { getLibrary } from '../../lib/content';
import '../../styles/v3-editorial.css';
import '../../styles/v3-book-followup.css';
const editorial = import.meta.env.HUNMENG_V2_PUBLIC === '1';

export function getStaticPaths() {
  return externalNovels.map(novel => ({ params: { slug: novel.slug }, props: { novel } }));
}
const { novel } = Astro.props;
// When rights-approved chapters are published, use the canonical on-site book.
const onSiteNovel = (await getLibrary()).find(book => book.slug === novel.slug);
---

<Layout
  title={`${novel.title} — ${onSiteNovel ? 'read on Hunmeng' : 'external novel reference'}`}
  description={novel.summary}
  bodyClass={editorial ? "hm-editorial-site" : undefined}
>
  {editorial && (
    <nav class="v3-primary-nav v3-book-extra-nav" aria-label="Reading room navigation">
      <a href="/">Home</a>
      <a href="/catalog/" aria-current="page">Books</a>
      <a href="/news/">Articles</a>
      <a href="/#v3-collections">Collections</a>
      <a href="/library/">My library</a>
      <a href="/about/">About</a>
    </nav>
  )}
  <main id="main" class="page-shell external-novel-page v3-source-page">
    <nav class="novel-detail-breadcrumb" aria-label="Breadcrumb">
      <a href="/catalog/">← Catalog</a><span aria-hidden="true">/</span>
      <span aria-current="page">{onSiteNovel ? 'Published novel' : 'External novel'}</span>
    </nav>
    <article class="external-novel-detail">
      <div class="external-novel-cover">
        <img src={onSiteNovel?.cover ?? novel.cover ?? '/images/novel-placeholder.svg'} alt={onSiteNovel ? `Cover of ${onSiteNovel.title}` : novel.coverAlt ?? ''} width="260" height="380" />
        <span>{onSiteNovel ? 'Read on Hunmeng' : novel.cover ? 'External reference · Hunmeng illustration' : 'External reference'}</span>
      </div>
      <div class="external-novel-copy">
        <p class="external-novel-eyebrow">{onSiteNovel ? 'Now published on Hunmeng' : 'External novel · chapters hosted elsewhere'}</p>
        <h1>{novel.title}</h1>
        <p class="external-novel-original" lang="zh">{novel.originalTitle}</p>
        <p class="external-novel-author">By <strong lang="zh">{novel.author}</strong></p>
        <div class="external-novel-tags">
          {novel.genres.map(genre => <span>{genre}</span>)}
          {novel.tags.map(tag => <span>{tag}</span>)}
        </div>
        <p class="external-novel-status"><strong>Original status:</strong> {novel.status}</p>
        <div class="external-novel-actions">
          {onSiteNovel && <a class="button" href={onSiteNovel.url}>Read on Hunmeng →</a>}
          <a class:list={['button', onSiteNovel && 'secondary']} href={novel.sourceUrl} target="_blank" rel="noopener noreferrer">Read on {novel.sourceName} ↗</a>
          <a class="button secondary" href={novel.originalUrl} target="_blank" rel="noopener noreferrer">Chinese original ↗</a>
        </div>
        <p class="fine">{onSiteNovel ? 'Authorized translated chapters are available in the Hunmeng reader. External reading sources remain linked for attribution.' : 'These links open third-party websites. Hunmeng does not host or translate chapters of this work while publication rights remain unverified.'}</p>
      </div>
    </article>
    <section class="external-novel-summary" aria-labelledby="external-synopsis-title">
      <h2 id="external-synopsis-title">About this story</h2>
      <p>{novel.summary}</p>
      <p class="fine">Reference: {novel.sourceName} #{novel.externalId.split(':')[1]}. Chapter availability and details may change at the source.</p>
    </section>
  </main>
</Layout>
