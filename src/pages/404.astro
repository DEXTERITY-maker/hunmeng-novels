---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Страница не найдена" noindex>
  <main id="main" class="page-shell error-page">
    <p class="error-number">404</p>
    <h1>Эта страница затерялась</h1>
    <p>Возможно, адрес изменился. Новые истории ждут в каталоге.</p>
    <a class="button" href="/catalog/">
      Открыть каталог
    </a>
  </main>
</Layout>
