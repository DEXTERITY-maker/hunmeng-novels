---
import Layout from '../layouts/Layout.astro';
import '../styles/v3-editorial.css';
import '../styles/v3-updates-utility.css';
const editorial = import.meta.env.HUNMENG_V2_PUBLIC === '1';
---

<Layout title="Page not found" noindex bodyClass={editorial ? 'hm-editorial-site' : undefined}>
  {editorial && (
    <nav class="v3-primary-nav v3-utility-nav" aria-label="Reading room navigation">
      <a href="/">Home</a>
      <a href="/catalog/">Books</a>
      <a href="/news/">Articles</a>
      <a href="/#v3-collections">Collections</a>
      <a href="/library/">My library</a>
      <a href="/about/">About</a>
    </nav>
  )}
  <main id="main" class="page-shell error-page v3-error-page">
    <p class="error-number">404</p>
    <h1>This page is lost</h1>
    <p>The address may have changed. New stories are waiting in the catalog.</p>
    <a class="button" href="/catalog/">
      Browse catalog
    </a>
  </main>
</Layout>
