---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews, newsCategories } from '../../lib/news';

const posts = await getNews();
---

<Layout title="Новости и обновления" description="Новости Hunmeng: обновления сайта, анонсы и события книжной платформы.">
  <main id="main" class="page-shell news-page">
    <header class="news-heading landscape-banner">
      <div>
        <p class="eyebrow">Хроники библиотеки Hunmeng</p><h1>Новости и обновления</h1>
        <p>Последние новости платформы, улучшения и новые возможности для читателей.</p>
      </div>
      <a class="news-back-link" href="/">← Главная</a>
    </header>
    <nav class="news-filter-tabs" aria-label="Категории новостей" id="news-filters">
      <a href="/news/" data-news-filter="all" aria-current="page">Все</a>
      {Object.entries(newsCategories).map(([key, label]) => (
        <a href={`/news/?category=${key}`} data-news-filter={key}>{label}</a>
      ))}
    </nav>
    <div class="news-feed" id="news-feed">
      {posts.map((post) => <NewsCard post={post} />)}
    </div>
    <p id="news-empty" class="home-section-empty" hidden>В этой категории пока нет новостей.</p>
    <nav id="news-pagination" class="news-pagination" aria-label="Страницы новостей" hidden></nav>
    <noscript>
      <p class="notice">Для фильтров и переключения страниц нужен JavaScript. Все новости доступны выше.</p>
    </noscript>
  </main>
  <script>
    import { initNewsFeed } from '../../scripts/news';
    initNewsFeed();
  </script>
</Layout>
