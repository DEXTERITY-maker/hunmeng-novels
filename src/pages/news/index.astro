---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews, newsCategories } from '../../lib/news';

const posts = await getNews();
---

<Layout title="News and updates" description="The latest Hunmeng news: site updates, announcements, and events.">
  <main id="main" class="page-shell news-page">
    <header class="news-heading news-hero">
      <div class="news-hero-copy">
        <p class="eyebrow">✦ From the Hunmeng library</p><h1>News</h1>
        <p>Updates, new features, events and announcements, with a look at everything new.</p>
      </div>
      <a class="news-back-link" href="/">← Home</a>
    </header>
    <nav class="news-filter-tabs" aria-label="News categories" id="news-filters">
      <a href="/news/" data-news-filter="all" aria-current="page">All</a>
      {Object.entries(newsCategories).map(([key, label]) => (
        <a href={`/news/?category=${key}`} data-news-filter={key}>{label}</a>
      ))}
    </nav>
    <div class="news-feed" id="news-feed">
      {posts.map((post) => <NewsCard post={post} />)}
    </div>
    <p id="news-empty" class="home-section-empty" hidden>There are no posts in this category yet.</p>
    <nav id="news-pagination" class="news-pagination" aria-label="News pages" hidden></nav>
    <noscript>
      <p class="notice">Filters and pagination require JavaScript. All news is available above without it.</p>
    </noscript>
  </main>
  <script>
    import { initNewsFeed } from '../../scripts/news';
    initNewsFeed();
  </script>
</Layout>
