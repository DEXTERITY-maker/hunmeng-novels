---
import Layout from '../../../layouts/Layout.astro';
import NovelCard from '../../../components/NovelCard.astro';
import CatalogHero from '../../../components/CatalogHero.astro';
import { getLibrary } from '../../../lib/content';
export async function getStaticPaths() {
  const PAGE_SIZE = 24;
  const novels = await getLibrary();
  const pages = Math.ceil(novels.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: { novels: novels.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE), page, pages },
    };
  });
}
const { novels, page, pages } = Astro.props;
---

<Layout title={`Catalog — page ${page}`} description="Browse Hunmeng novels with pagination that works without JavaScript.">
  <main id="main" class="page-shell catalog-page">
    <CatalogHero page={page} pages={pages} />
    <div class="novel-grid">
      {novels.map((novel) => <NovelCard novel={novel} />)}
    </div>
    <nav class="catalog-pagination" aria-label="Catalog pages">
      <a href={page === 2 ? '/catalog/' : `/catalog/page/${page - 1}/`}>← Previous</a>
      <span>Page {page} of {pages}</span>
      {page < pages && <a href={`/catalog/page/${page + 1}/`}>Next →</a>}
    </nav>
  </main>
</Layout>
