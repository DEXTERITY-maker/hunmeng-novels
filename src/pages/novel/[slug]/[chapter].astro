---
import ReaderView from '../../../components/ReaderView.astro';
import { getLibrary } from '../../../lib/content';
import serials from '../../../data/serials.json';
export async function getStaticPaths() {
  return (await getLibrary()).flatMap(n => {
    const local = n.chapters.map((c, i) => ({
      params: { slug: n.slug, chapter: c.data.slug },
      props: { novel: n, chapter: c, index: i },
    }));
    const serial = serials.find(s => s.slug === n.slug);
    const scheduled = (serial?.chapters.filter(c => c.number > serial.initialChapters) ?? []).map(c => ({
      params: { slug: n.slug, chapter: `chapter-${c.number}` },
      props: { novel: n, index: c.number - 1, remoteNumber: c.number, remoteTitle: c.title },
    }));
    return [...local, ...scheduled];
  });
}
---
<ReaderView {...Astro.props} />
