---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getLibrary, chapterUrl, chapterCount } from '../../../lib/content';
import { CHAPTERS_PER_PAGE, chapterListUrl } from '../../../lib/pagination';
import { chapterReportUrl, chapterStructuredData, socialCover } from '../../../lib/seo';
import { site } from '../../../config/site';
export async function getStaticPaths() {
  return (await getLibrary()).flatMap((n) =>
    n.chapters.map((c, i) => ({
      params: { slug: n.slug, chapter: c.data.slug },
      props: { novel: n, chapter: c, index: i },
    })),
  );
}
const { novel: n, chapter: c, index } = Astro.props;
const { Content } = await render(c);
const prev = n.chapters[index - 1],
  next = n.chapters[index + 1];
const nearby = n.chapters.slice(Math.max(0, index - 10), Math.min(n.chapterCount, index + 11));
const tocPage = Math.floor(index / CHAPTERS_PER_PAGE) + 1;
const structuredData = chapterStructuredData(n, c, Astro.site || site.url);
const reportHref = chapterReportUrl(site.reportUrl, n.slug, c.data.number);
const coverIsSvg = n.cover.endsWith('.svg');
---

<Layout
  title={`${n.title} — chapter ${c.data.number}: ${c.data.title}`}
  description={c.data.description}
  ogImage={socialCover(n.cover)}
  ogImageWidth={coverIsSvg ? 520 : undefined}
  ogImageHeight={coverIsSvg ? 760 : undefined}
  ogImageAlt={`Novel cover «${n.title}»`}
  structuredData={structuredData}
  reader
>
  <header class="reader-header reader-chrome">
    <a href={n.url} class="reader-back" aria-label="Back to novel">
      ←
    </a>
    <a href={n.url} class="reader-novel-title">
      {n.title}
    </a>
    <button type="button" class="icon-button" data-open="toc" aria-label="Open contents">
      ☰
    </button>
  </header>
  <div class="reading-progress">
    <progress
      id="reading-progress"
      value="0"
      max="100"
      aria-label="Chapter reading progress"
    ></progress>
  </div>
  <main
    id="main"
    class="reader-main"
    data-reader
    data-novel={n.slug}
    data-chapter={c.data.slug}
    data-number={c.data.number}
  >
    <div class="reader-heading">
      <a href={n.url}>{n.title}</a>
      <p class="fine">
        Chapter {c.data.number} of {n.chapterCount}
      </p>
      <h1>{c.data.title}</h1>
    </div>
    <article
      id="chapter-text"
      class="chapter-text"
      aria-label={`Chapter ${c.data.number}. ${c.data.title}`}
    >
      <Content />
    </article>
    <nav class="chapter-end-nav" aria-label="Chapter navigation">
      {prev ? (
        <a class="button secondary" href={chapterUrl(n.slug, prev.data.slug)}>
          ← Previous
        </a>
      ) : (
        <a class="button secondary" href={n.url}>
          Back to novel
        </a>
      )}
      {next ? (
        <a class="button" href={chapterUrl(n.slug, next.data.slug)}>
          Next →
        </a>
      ) : (
        <a class="button" href={n.url}>
          Back to contents →
        </a>
      )}
    </nav>
    {!next && <p class="end-note">You have read all published chapters.</p>}
    {reportHref && (
      <div class="chapter-report">
        <a href={reportHref} class="chapter-report-link" target="_blank" rel="noopener noreferrer">
          Report an error ↗
        </a>
      </div>
    )}
  </main>
  <nav class="reader-toolbar reader-chrome" aria-label="Reading controls">
    <button type="button" data-open="toc">
      <span aria-hidden="true">☰</span> Contents
    </button>
    <button type="button" data-open="settings">
      <span aria-hidden="true">Aa</span> Settings
    </button>
    <span id="progress-label" class="fine">
      0%
    </span>
    <div class="toolbar-arrows">
      {prev ? (
        <a href={chapterUrl(n.slug, prev.data.slug)} aria-label="Previous chapter">
          ←
        </a>
      ) : (
        <span aria-hidden="true" class="disabled">
          ←
        </span>
      )}
      {next ? (
        <a href={chapterUrl(n.slug, next.data.slug)} aria-label="Next chapter">
          →
        </a>
      ) : (
        <span aria-hidden="true" class="disabled">
          →
        </span>
      )}
    </div>
  </nav>
  <button
    id="show-reader-controls"
    class="show-controls"
    type="button"
    aria-label="Show reading controls"
    hidden
  >
    Aa
  </button>
  <dialog id="reader-settings" class="reader-dialog" aria-labelledby="settings-title">
    <div class="dialog-heading">
      <h2 id="settings-title">Reading settings</h2>
      <button type="button" class="icon-button" data-close aria-label="Close settings">
        ×
      </button>
    </div>
    <form id="settings-form">
      <fieldset>
        <legend>Font</legend>
        <div class="font-choices">
          <label>
            <input type="radio" name="font" value="serif" checked />
            <span class="font-serif">Aa</span>Book
          </label>
          <label>
            <input type="radio" name="font" value="sans" />
            <span class="font-sans">Aa</span>Modern
          </label>
          <label>
            <input type="radio" name="font" value="system" />
            <span>Aa</span>System
          </label>
        </div>
      </fieldset>
      <label>
        Text size <output data-output="size">20 px</output>
        <input name="size" type="range" min="16" max="32" step="1" value="20" />
      </label>
      <label>
        Line height <output data-output="lineHeight">1,85</output>
        <input name="lineHeight" type="range" min="1.4" max="2.4" step="0.05" value="1.85" />
      </label>
      <label>
        Column width <output data-output="width">720 px</output>
        <input name="width" type="range" min="480" max="960" step="40" value="720" />
        <small>On mobile, the width is limited to your screen.</small>
      </label>
      <fieldset>
        <legend>Theme</legend>
        <div class="theme-choices">
          <label>
            <input type="radio" name="theme" value="system" checked />
            <span class="theme-sample system-sample">Aa</span>System default
          </label>
          <label>
            <input type="radio" name="theme" value="light" />
            <span class="theme-sample light-sample">Aa</span>Light
          </label>
          <label>
            <input type="radio" name="theme" value="dark" />
            <span class="theme-sample dark-sample">Aa</span>Dark
          </label>
          <label>
            <input type="radio" name="theme" value="sepia" />
            <span class="theme-sample sepia-sample">Aa</span>Sepia
          </label>
        </div>
      </fieldset>
      <button type="button" id="reset-settings" class="text-button">
        Reset to default
      </button>
      <p class="fine">Changes are saved automatically.</p>
    </form>
  </dialog>
  <dialog id="reader-toc" class="reader-dialog" aria-labelledby="toc-title">
    <div class="dialog-heading">
      <h2 id="toc-title">Contents</h2>
      <button type="button" class="icon-button" data-close aria-label="Close contents">
        ×
      </button>
    </div>
    <p>{n.title}</p>
    <ol class="chapter-list">
      {nearby.map((ch) => (
        <li>
          <a
            href={chapterUrl(n.slug, ch.data.slug)}
            aria-current={ch.data.slug === c.data.slug ? 'page' : undefined}
          >
            Chapter {ch.data.number}. {ch.data.title}
          </a>
        </li>
      ))}
    </ol>
    <a class="reader-toc-all" href={chapterListUrl(n.slug, tocPage)}>Full contents ({chapterCount(n.chapterCount)}) →</a>
  </dialog>
  <noscript>
    <p class="notice">
      Saving your position and settings requires JavaScript. Chapter text and navigation are still available.
    </p>
  </noscript>
  <script>
    import { initReader } from '../../../scripts/reader';
    void initReader();
  </script>
</Layout>
