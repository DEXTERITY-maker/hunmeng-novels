---
import Layout from '../../../../layouts/Layout.astro';
import { getLibrary, chapterUrl, chapterCount, dateLabel } from '../../../../lib/content';
import { CHAPTERS_PER_PAGE, chapterPageCount, chapterListUrl } from '../../../../lib/pagination';
import '../../../../styles/v3-editorial.css';
import '../../../../styles/v3-book-followup.css';
const editorial = import.meta.env.HUNMENG_V2_PUBLIC === '1';

export async function getStaticPaths() {
  const novels = await getLibrary();
  return novels.flatMap((novel) => {
    const pages = chapterPageCount(novel.chapterCount);
    return Array.from({ length: pages }, (_, i) => ({
      params: { slug: novel.slug, page: String(i + 1) },
      props: { novel, page: i + 1, pages },
    }));
  });
}
const { novel: n, page, pages } = Astro.props;
const chapters = n.chapters.slice((page - 1) * CHAPTERS_PER_PAGE, page * CHAPTERS_PER_PAGE);
---

<Layout title={`${n.title} contents — page ${page}`} description={`Chapters of ${n.title}, page ${page} of ${pages}.`} bodyClass={editorial ? "hm-editorial-site" : undefined}>
  {editorial && (
    <nav class="v3-primary-nav v3-book-extra-nav" aria-label="Reading room navigation">
      <a href="/">Home</a>
      <a href="/catalog/" aria-current="page">Books</a>
      <a href="/news/">Articles</a>
      <a href="/#v3-collections">Collections</a>
      <a href="/library/">My library</a>
      <a href="/about/">About</a>
    </nav>
  )}
  <main id="main" class="page-shell chapter-pages v3-chapter-index">
    <a class="back-link" href={n.url}>← Back to novel</a>
    <div class="page-heading">
      <h1>{n.title}</h1>
      <p>{chapterCount(n.chapterCount)} · Page {page} of {pages}</p>
    </div>
    <nav class="chapter-pagination" aria-label="Contents pages">
      {page > 1 && <a href={chapterListUrl(n.slug, page - 1)}>← Previous 100</a>}
      <span>Chapters {chapters[0].data.number}–{chapters.at(-1)!.data.number}</span>
      {page < pages && <a href={chapterListUrl(n.slug, page + 1)}>Next 100 →</a>}
    </nav>
    <ol class="chapter-list">
      {chapters.map((chapter) => (
        <li>
          <a href={chapterUrl(n.slug, chapter.data.slug)}>
            <span><span class="chapter-number">{String(chapter.data.number).padStart(2, '0')}</span>{chapter.data.title}</span>
            <time datetime={chapter.data.publishedAt}>{dateLabel(chapter.data.publishedAt)}</time>
          </a>
        </li>
      ))}
    </ol>
    <nav class="chapter-pagination" aria-label="Contents navigation">
      <a href={n.url}>Back to overview</a>
      {page > 1 && <a href={chapterListUrl(n.slug, page - 1)}>← Previous</a>}
      <span>{page} / {pages}</span>
      {page < pages && <a href={chapterListUrl(n.slug, page + 1)}>Next →</a>}
    </nav>
  </main>
</Layout>
