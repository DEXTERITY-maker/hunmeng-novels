---
import Layout from '../../../layouts/Layout.astro';
import LibraryControl from '../../../components/LibraryControl.astro';
import Icon from '../../../components/Icon.astro';
import ReaderReviews from '../../../components/ReaderReviews.astro';
import { getLibrary, dateLabel, chapterCount, chapterUrl } from '../../../lib/content';
import { chapterListUrl } from '../../../lib/pagination';
import { novelStructuredData, placeholderCover, socialCover } from '../../../lib/seo';
import { site } from '../../../config/site';
import serials from '../../../data/serials.json';
export async function getStaticPaths() {
  return (await getLibrary()).map((n) => ({ params: { slug: n.slug }, props: { novel: n } }));
}
const { novel: n } = Astro.props;
const serial = serials.find(s => s.slug === n.slug);
const firstChapters = n.chapters.slice(0, 10);
const glossaryKinds = [
  { type: 'character', title: 'Characters' },
  { type: 'place', title: 'Places' },
  { type: 'technique', title: 'Techniques' },
  { type: 'item', title: 'Items' },
] as const;
const glossaryGroups = glossaryKinds.map(({ type, title }) => ({
  title, entries: n.glossary.filter((term) => term.type === type),
})).filter(({ entries }) => entries.length > 0);
const structuredData = novelStructuredData(n, Astro.site || site.url);
const coverIsSvg = n.cover.endsWith('.svg');
const usesPlaceholder = n.cover === placeholderCover;
// Categories that already appear as tags would show the same pill twice.
const extraCategories = n.categories.filter((category) =>
  ![...n.genres, ...n.tags].some((term) => term.toLocaleLowerCase('en') === category.toLocaleLowerCase('en')),
);
---

<Layout
  title={`${n.title} — read online`}
  description={n.description}
  ogImage={usesPlaceholder ? undefined : socialCover(n.cover)}
  ogImageWidth={coverIsSvg ? 520 : undefined}
  ogImageHeight={coverIsSvg ? 760 : undefined}
  ogImageAlt={usesPlaceholder ? undefined : `Novel cover “${n.title}”`}
  structuredData={structuredData}
>
  {n.art && <div class="novel-art-band" data-novel-art={n.art} aria-hidden="true"></div>}
  <main id="main" class:list={['page-shell', 'novel-page', n.art && 'novel-page-with-art']}>
    <article class="novel-detail" data-novel-detail={n.slug}>
      <nav class="novel-detail-breadcrumb" aria-label="Breadcrumb">
        <a href="/catalog/"><span aria-hidden="true">←</span> Catalog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{n.title}</span>
      </nav>
      <div class="novel-book-shell">
        <img
          class="detail-cover"
          src={n.cover}
          alt={`Cover: ${n.title}`}
          width="260"
          height="380"
          fetchpriority="high"
        />
      </div>
      <div class="detail-copy">
        <p class="genre-line genre-links" aria-label="Genres">
          {n.genres.map(genre => <a href={`/catalog/?genre=${encodeURIComponent(genre)}`}>{genre}</a>)}
        </p>
        <h1>{n.title}</h1>
        {n.originalTitle !== n.title && <p class="original-title">{n.originalTitle}</p>}
        <p class="author">{n.author}</p>
        <div class="detail-actions">
          <a class="button novel-primary-read" href={n.firstUrl} data-continue={n.slug} aria-label="Start reading">
            <Icon name="book" size={19} />
            <span class="novel-read-label">Start reading</span>
          </a>
          <LibraryControl slug={n.slug} withIcon />
          <a class="detail-contents-link" href="#contents-title">Contents <span aria-hidden="true">→</span></a>
        </div>
        <div class="serial-publication-stats" aria-label="Chapter publication progress">
          <span><Icon name="book" size={18} /> <strong>{n.chapterCount}</strong> published chapters</span>
          {serial && <>
            <span><Icon name="layers" size={18} /> <strong>{serial.totalChapters}</strong> planned in total</span>
            <a href={`${n.url}releases/`}><Icon name="clock" size={18} /> Release schedule <span aria-hidden="true">→</span></a>
          </>}
        </div>
        <div class="novel-metadata-row">
          <dl class="novel-facts">
            {n.original ? (
              <div>
                <dt>Status</dt>
                <dd><span class:list={['novel-status-dot', n.originalStatus === 'Ongoing' && 'is-ongoing']} aria-hidden="true"></span>{n.originalStatus}</dd>
              </div>
            ) : (
              <>
                <div><dt>Original</dt><dd><span class:list={['novel-status-dot', n.originalStatus === 'Ongoing' && 'is-ongoing']} aria-hidden="true"></span>{n.originalStatus}</dd></div>
                <div><dt>Translation</dt><dd><span class:list={['novel-status-dot', n.translationStatus === 'In progress' && 'is-ongoing']} aria-hidden="true"></span>{n.translationStatus}</dd></div>
              </>
            )}
            <div><dt>Length</dt><dd>{chapterCount(n.chapterCount)}</dd></div>
            {n.rating && <div><dt>Reader rating</dt><dd>★ {n.rating.average.toFixed(1)} / 5 · {n.rating.count} ratings</dd></div>}
            {typeof n.views === 'number' && <div><dt>Views</dt><dd>{new Intl.NumberFormat('en-US').format(n.views)}</dd></div>}
            <div><dt>Updated</dt><dd><time datetime={n.updatedAt}>{dateLabel(n.updatedAt)}</time></dd></div>
          </dl>
          <div class="personal-rating" data-rating-novel={n.slug}>
            <p class="personal-rating-title">Your rating</p>
            <div class="personal-rating-stars" role="group" aria-label="Rate this novel">
              {[1, 2, 3, 4, 5].map((star) => (
                <button type="button" data-star={star} aria-label={`Rate ${star} out of 5`} aria-pressed="false">☆</button>
              ))}
            </div>
            <p class="fine" data-rating-status aria-live="polite">You have not rated this novel yet.</p>
          </div>
        </div>
        <div class="tag-list novel-detail-tags" aria-label="Tags">
          {n.tags.map(t => <a href={`/catalog/?include=${encodeURIComponent(t)}`}>{t}</a>)}
        </div>
        {extraCategories.length > 0 && (
          <div class="work-categories" aria-label="Categories">
            {extraCategories.map((category) => (
              <a href={`/catalog/?category=${encodeURIComponent(category)}`}>{category}</a>
            ))}
          </div>
        )}
        {n.demo && <p class="fine">Demo novel. The story and author are fictional.</p>}
      </div>
    </article>
    <section class="synopsis-panel" aria-labelledby="synopsis-title">
      <h2 id="synopsis-title">Synopsis <span class="synopsis-ornament" aria-hidden="true">✦</span></h2>
      <p class="detail-description">{n.description}</p>
    </section>
    <nav class="novel-section-nav" aria-label="Novel sections">
      <a href="#contents-title">Contents</a>
      <a href="#author-title">About the author</a>
      {glossaryGroups.length > 0 && <a href="#glossary-title">Glossary</a>}
    </nav>
    <section class="section contents-section" aria-labelledby="contents-title">
      {serial && <p class="notice" data-serial-summary={n.slug} data-published={n.chapterCount}><span data-serial-summary-text>The novel is being written. The daily schedule has not started yet. Once the complete manuscript is ready: {serial.initialChapters} chapters at launch, then one daily at 12:00 Moscow time. </span><a href={`${n.url}releases/`}>Check chapter availability →</a></p>}
      <div class="section-heading">
        <h2 id="contents-title">Contents</h2>
        <span class="fine">{chapterCount(n.chapterCount)}</span>
      </div>
      <ol class="chapter-list">
        {firstChapters.map((c) => (
          <li>
            <a href={chapterUrl(n.slug, c.data.slug)} data-chapter-slug={c.data.slug}>
              <span>
                <span class="chapter-number">{String(c.data.number).padStart(2, '0')}</span>
                {c.data.title}
              </span>
              <time datetime={c.data.publishedAt}>{dateLabel(c.data.publishedAt)}</time>
            </a>
          </li>
        ))}
      </ol>
      <div class="chapter-pages-footer">
        <p class="fine">{n.chapterCount > firstChapters.length ? `Showing ${chapterCount(firstChapters.length)} of ${n.chapterCount}.` : `Available to read: ${chapterCount(n.chapterCount)}.`}</p>
        <a class="button secondary" href={chapterListUrl(n.slug, 1)}>Full contents →</a>
      </div>
    </section>
    <ReaderReviews slug={n.slug} />
    <section class="section author-section" aria-labelledby="author-title">
      <div class="section-heading"><h2 id="author-title">About the author</h2></div>
      <p class="author-info-name">{n.author}</p>
      {(n.authorUrl || n.supportUrl) && (
        <div class="author-outbound-links">
          {n.authorUrl && (
            <a href={n.authorUrl} target="_blank" rel="noopener noreferrer">Author's original ↗</a>
          )}
          {n.supportUrl && (
            <a href={n.supportUrl} target="_blank" rel="noopener noreferrer">Support the author ↗</a>
          )}
        </div>
      )}
      {n.original ? (
        <p class="fine author-permission">An original story written for Hunmeng.</p>
      ) : (
        !n.demo && <p class="fine author-permission">Published with the author's permission.</p>
      )}
    </section>
    {glossaryGroups.length > 0 && (
      <section class="section glossary-section" aria-labelledby="glossary-title">
        <div class="section-heading"><h2 id="glossary-title">Glossary</h2></div>
        <div class="glossary-groups">
          {glossaryGroups.map((group) => (
            <div class="glossary-group">
              <h3>{group.title}</h3>
              <dl class="glossary-entries">
                {group.entries.map((term) => (
                  <div class="glossary-entry">
                    <dt>{term.translation}</dt>
                    <dd>{term.original}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
  <script>
    import { initReaderReviews } from '../../../scripts/reader-reviews';
    void initReaderReviews();
    import { initPersonal } from '../../../scripts/personal';
    void initPersonal();
    import { initPersonalRatings } from '../../../scripts/rating';
    initPersonalRatings();
    import { initSerialSummary } from '../../../scripts/serial-summary';
    void initSerialSummary();
  </script>
</Layout>
