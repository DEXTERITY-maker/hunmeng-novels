---
import Layout from '../../../layouts/Layout.astro';
import LibraryControl from '../../../components/LibraryControl.astro';
import { getLibrary, dateLabel, chapterCount, chapterUrl } from '../../../lib/content';
import { chapterListUrl } from '../../../lib/pagination';
export async function getStaticPaths() {
  return (await getLibrary()).map((n) => ({ params: { slug: n.slug }, props: { novel: n } }));
}
const { novel: n } = Astro.props;
const firstChapters = n.chapters.slice(0, 30);
---

<Layout title={`${n.title} — читать онлайн`} description={n.description}>
  <main id="main" class="page-shell">
    <a class="back-link" href="/catalog/">
      ← Каталог
    </a>
    <article class="novel-detail" data-novel-detail={n.slug}>
      <img
        class="detail-cover"
        src={n.cover}
        alt={`Обложка: ${n.title}`}
        width="260"
        height="380"
        fetchpriority="high"
      />
      <div class="detail-copy">
        <p class="genre-line">{n.genres.join(' · ')}</p>
        <div class="work-categories" aria-label="Категории">
          {n.categories.map((category) => (
            <a href={`/catalog/?category=${encodeURIComponent(category)}`}>{category}</a>
          ))}
        </div>
        <h1>{n.title}</h1>
        <p class="original-title">{n.originalTitle}</p>
        <p class="author">{n.author}</p>
        <p class="detail-description">{n.description}</p>
        <dl class="novel-facts">
          <div>
            <dt>Оригинал</dt>
            <dd>{n.originalStatus}</dd>
          </div>
          <div>
            <dt>Перевод</dt>
            <dd>{n.translationStatus}</dd>
          </div>
          <div>
            <dt>Объём</dt>
            <dd>{chapterCount(n.chapterCount)}</dd>
          </div>
          <div>
            <dt>Рейтинг читателей</dt>
            <dd>{n.rating ? `★ ${n.rating.average.toFixed(1)} / 5 · ${n.rating.count} оценок` : 'Пока нет оценок'}</dd>
          </div>
          <div>
            <dt>Просмотры</dt>
            <dd>{typeof n.views === 'number' ? new Intl.NumberFormat('ru-RU').format(n.views) : 'Нет данных'}</dd>
          </div>
          <div>
            <dt>Обновлено</dt>
            <dd>
              <time datetime={n.updatedAt}>{dateLabel(n.updatedAt)}</time>
            </dd>
          </div>
        </dl>
        <div class="tag-list">
          {n.tags.map((t) => (
            <a href={`/catalog/?include=${encodeURIComponent(t)}`}>{t}</a>
          ))}
        </div>
        <div class="personal-rating" data-rating-novel={n.slug}>
          <p class="personal-rating-title">Ваша оценка</p>
          <div class="personal-rating-stars" role="group" aria-label="Поставить личную оценку">
            {[1, 2, 3, 4, 5].map((star) => (
              <button type="button" data-star={star} aria-label={`Оценить на ${star} из 5`} aria-pressed="false">★</button>
            ))}
          </div>
          <p class="fine" data-rating-status aria-live="polite">Оценка сохраняется только на вашем устройстве и не влияет на общий рейтинг.</p>
        </div>
        <div class="detail-actions">
          <a class="button" href={n.firstUrl} data-continue={n.slug}>
            Начать читать
          </a>
          <LibraryControl slug={n.slug} />
        </div>
        <p class="fine">
          {n.demo
            ? 'Демонстрационная новелла. Текст и автор вымышлены; ссылка на оригинал — пример.'
            : 'Перевод нейросетью с разрешения автора.'}{' '}
          <a href={n.originalUrl} target="_blank" rel="noopener noreferrer">
            {n.demo ? 'Пример ссылки на оригинал ↗' : 'Оригинал ↗'}
          </a>
        </p>
      </div>
    </article>
    <section class="section contents-section" aria-labelledby="contents-title">
      <div class="section-heading">
        <h2 id="contents-title">Оглавление</h2>
        <span class="fine">{chapterCount(n.chapterCount)}</span>
      </div>
      <ol class="chapter-list">
        {firstChapters.map((c) => (
          <li>
            <a href={chapterUrl(n.slug, c.data.slug)} data-chapter-slug={c.data.slug}>
              <span>
                <span class="chapter-number">{String(c.data.number).padStart(2, '0')}</span>
                {c.data.title}
              </span>
              <time datetime={c.data.publishedAt}>{dateLabel(c.data.publishedAt)}</time>
            </a>
          </li>
        ))}
      </ol>
      <div class="chapter-pages-footer">
        <p class="fine">{n.chapterCount > firstChapters.length ? `Показаны первые ${firstChapters.length} глав из ${n.chapterCount}.` : `Все ${n.chapterCount} глав доступны по ссылкам выше.`}</p>
        <a class="button secondary" href={chapterListUrl(n.slug, 1)}>Полное оглавление →</a>
      </div>
    </section>
  </main>
  <script>
    import { initPersonal } from '../../../scripts/personal';
    void initPersonal();
    import { initPersonalRatings } from '../../../scripts/rating';
    initPersonalRatings();
  </script>
</Layout>
