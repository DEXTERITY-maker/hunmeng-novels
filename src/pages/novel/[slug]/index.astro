---
import Layout from '../../../layouts/Layout.astro';
import LibraryControl from '../../../components/LibraryControl.astro';
import { getLibrary, dateLabel, chapterCount, chapterUrl } from '../../../lib/content';
import { chapterListUrl } from '../../../lib/pagination';
import { novelStructuredData, socialCover } from '../../../lib/seo';
import { site } from '../../../config/site';
export async function getStaticPaths() {
  return (await getLibrary()).map((n) => ({ params: { slug: n.slug }, props: { novel: n } }));
}
const { novel: n } = Astro.props;
const firstChapters = n.chapters.slice(0, 30);
const glossaryKinds = [
  { type: 'персонаж', title: 'Персонажи' },
  { type: 'место', title: 'Места' },
  { type: 'техника', title: 'Техники' },
  { type: 'предмет', title: 'Предметы' },
] as const;
const glossaryGroups = glossaryKinds.map(({ type, title }) => ({
  title, entries: n.glossary.filter((term) => term.type === type),
})).filter(({ entries }) => entries.length > 0);
const structuredData = novelStructuredData(n, Astro.site || site.url);
const coverIsSvg = n.cover.endsWith('.svg');
---

<Layout
  title={`${n.title} — читать онлайн`}
  description={n.description}
  ogImage={socialCover(n.cover)}
  ogImageWidth={coverIsSvg ? 520 : undefined}
  ogImageHeight={coverIsSvg ? 760 : undefined}
  ogImageAlt={`Обложка новеллы «${n.title}»`}
  structuredData={structuredData}
>
  <main id="main" class="page-shell">
    <a class="back-link" href="/catalog/">
      ← Каталог
    </a>
    <article class="novel-detail" data-novel-detail={n.slug}>
      <img
        class="detail-cover"
        src={n.cover}
        alt={`Обложка: ${n.title}`}
        width="260"
        height="380"
        fetchpriority="high"
      />
      <div class="detail-copy">
        <p class="genre-line">{n.genres.join(' · ')}</p>
        <div class="work-categories" aria-label="Категории">
          {n.categories.map((category) => (
            <a href={`/catalog/?category=${encodeURIComponent(category)}`}>{category}</a>
          ))}
        </div>
        <h1>{n.title}</h1>
        <p class="original-title">{n.originalTitle}</p>
        <p class="author">{n.author}</p>
        <p class="detail-description">{n.description}</p>
        <dl class="novel-facts">
          <div>
            <dt>Оригинал</dt>
            <dd>{n.originalStatus}</dd>
          </div>
          <div>
            <dt>Перевод</dt>
            <dd>{n.translationStatus}</dd>
          </div>
          <div>
            <dt>Объём</dt>
            <dd>{chapterCount(n.chapterCount)}</dd>
          </div>
          {n.rating && (
            <div>
              <dt>Рейтинг читателей</dt>
              <dd>★ {n.rating.average.toFixed(1)} / 5 · {n.rating.count} оценок</dd>
            </div>
          )}
          {typeof n.views === 'number' && (
            <div>
              <dt>Просмотры</dt>
              <dd>{new Intl.NumberFormat('ru-RU').format(n.views)}</dd>
            </div>
          )}
          <div>
            <dt>Обновлено</dt>
            <dd>
              <time datetime={n.updatedAt}>{dateLabel(n.updatedAt)}</time>
            </dd>
          </div>
        </dl>
        <div class="tag-list">
          {n.tags.map((t) => (
            <a href={`/catalog/?include=${encodeURIComponent(t)}`}>{t}</a>
          ))}
        </div>
        <div class="personal-rating" data-rating-novel={n.slug}>
          <p class="personal-rating-title">Ваша оценка</p>
          <div class="personal-rating-stars" role="group" aria-label="Поставить личную оценку">
            {[1, 2, 3, 4, 5].map((star) => (
              <button type="button" data-star={star} aria-label={`Оценить на ${star} из 5`} aria-pressed="false">★</button>
            ))}
          </div>
          <p class="fine" data-rating-status aria-live="polite">Оценка сохраняется только на вашем устройстве и не влияет на общий рейтинг.</p>
        </div>
        <div class="detail-actions">
          <a class="button" href={n.firstUrl} data-continue={n.slug}>
            Начать читать
          </a>
          <LibraryControl slug={n.slug} />
        </div>
        {n.demo && (
          <p class="fine">Демонстрационная новелла. Текст и автор вымышлены.</p>
        )}
      </div>
    </article>
    <section class="section author-section" aria-labelledby="author-title">
      <div class="section-heading"><h2 id="author-title">Об авторе</h2></div>
      <p class="author-info-name">{n.author}</p>
      {(n.authorUrl || n.supportUrl) && (
        <div class="author-outbound-links">
          {n.authorUrl && (
            <a href={n.authorUrl} target="_blank" rel="noopener noreferrer">Оригинал у автора ↗</a>
          )}
          {n.supportUrl && (
            <a href={n.supportUrl} target="_blank" rel="noopener noreferrer">Поддержать автора ↗</a>
          )}
        </div>
      )}
      {!n.demo && <p class="fine author-permission">Перевод публикуется с разрешения автора.</p>}
    </section>
    {glossaryGroups.length > 0 && (
      <section class="section glossary-section" aria-labelledby="glossary-title">
        <div class="section-heading"><h2 id="glossary-title">Глоссарий</h2></div>
        <div class="glossary-groups">
          {glossaryGroups.map((group) => (
            <div class="glossary-group">
              <h3>{group.title}</h3>
              <dl class="glossary-entries">
                {group.entries.map((term) => (
                  <div class="glossary-entry">
                    <dt>{term.translation}</dt>
                    <dd>{term.original}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </section>
    )}
    <section class="section contents-section" aria-labelledby="contents-title">
      <div class="section-heading">
        <h2 id="contents-title">Оглавление</h2>
        <span class="fine">{chapterCount(n.chapterCount)}</span>
      </div>
      <ol class="chapter-list">
        {firstChapters.map((c) => (
          <li>
            <a href={chapterUrl(n.slug, c.data.slug)} data-chapter-slug={c.data.slug}>
              <span>
                <span class="chapter-number">{String(c.data.number).padStart(2, '0')}</span>
                {c.data.title}
              </span>
              <time datetime={c.data.publishedAt}>{dateLabel(c.data.publishedAt)}</time>
            </a>
          </li>
        ))}
      </ol>
      <div class="chapter-pages-footer">
        <p class="fine">{n.chapterCount > firstChapters.length ? `В списке: ${chapterCount(firstChapters.length)} из ${n.chapterCount}.` : `Доступно для чтения: ${chapterCount(n.chapterCount)}.`}</p>
        <a class="button secondary" href={chapterListUrl(n.slug, 1)}>Полное оглавление →</a>
      </div>
    </section>
  </main>
  <script>
    import { initPersonal } from '../../../scripts/personal';
    void initPersonal();
    import { initPersonalRatings } from '../../../scripts/rating';
    initPersonalRatings();
  </script>
</Layout>
