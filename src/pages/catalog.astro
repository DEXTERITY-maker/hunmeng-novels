---
import Layout from '../layouts/Layout.astro';
import { renderCatalogCard } from '../lib/catalog-card';
import CatalogHero from '../components/CatalogHero.astro';
import { externalCatalogEntries } from '../lib/external-catalog';
import { getLibrary } from '../lib/content';
import { getTaxonomy } from '../lib/taxonomy';
const novels = await getLibrary();
// External listings are searchable, but are not published chapters or reader rewards.
const catalogItems = [...novels, ...externalCatalogEntries];
const { genres, tags, groups } = getTaxonomy(catalogItems);
const categories = [...new Set(catalogItems.flatMap((n) => n.categories))].sort((a, b) => a.localeCompare(b, 'en'));
const pickerTags = [...tags].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'en'));
const PAGE_SIZE = 24;
---

<Layout
  title="Web novel catalog — advanced search"
  description="Explore Hunmeng novels by title, author, category, genre, tags, ratings, and recent updates."
>
  <main id="main" class="page-shell catalog-page">
    <CatalogHero />
    <div class="catalog-layout">
      <form id="catalog-filters" class="filter-panel catalog-filter-panel" role="search">
        <div class="catalog-filter-header">
          <h2>Find your next read</h2><p>Search the library and refine your selection.</p>
          <button type="reset" class="text-button">Reset filters</button>
        </div>
        <div class="catalog-search-row">
          <label class="search-label">
            Title or author
            <input type="search" name="search" placeholder="English or original title" autocomplete="off" />
          </label>
          <label class="catalog-quick-sort">
            Sort by
            <select name="sort">
              <option value="updated">Recently updated</option>
              <option value="added">Recently added</option>
              <option value="title">Title: A–Z</option>
              <option value="chapters">Chapter count</option>
              <option value="rating">Rating</option>
              <option value="views">Views</option>
            </select>
          </label>
        </div>
        <details id="catalog-options" class="catalog-options">
          <summary><span class="filters-summary-title">Filters and sorting</span><span id="active-filter-count" hidden></span></summary>
          <div class="catalog-controls">
            <label>
              Category
              <select name="category">
                <option value="">All categories</option>
                {categories.map((category) => <option value={category}>{category}</option>)}
              </select>
            </label>
            <label>
              Genre
              <select name="genre">
                <option value="">All genres</option>
                {genres.map((genre) => <option value={genre.label}>{genre.label} ({genre.count})</option>)}
              </select>
            </label>
            <label>
              Translation status
              <select name="status">
                <option value="">All statuses</option>
                {['In progress', 'Completed', 'On hiatus'].map((status) => <option>{status}</option>)}
              </select>
            </label>
            <label>
              Original status
              <select name="originalStatus">
                <option value="">All statuses</option>
                {['Ongoing', 'Completed', 'On hiatus'].map((status) => <option>{status}</option>)}
              </select>
            </label>
            <label>
              Minimum chapters
              <input type="number" name="minChapters" min="0" max="1000000" step="1" inputmode="numeric" placeholder="No minimum" />
            </label>
            <label>
              Minimum rating
              <select name="minRating">
                <option value="">Any rating</option>
                <option value="3">3 out of 5 or higher</option>
                <option value="4">4 out of 5 or higher</option>
                <option value="4.5">4.5 out of 5 or higher</option>
              </select>
            </label>
            <label>
              Per page
              <select name="size">
                <option value="24">24 novels</option>
                <option value="48">48 novels</option>
              </select>
            </label>
          </div>
          <details class="tag-filters">
            <summary>Advanced tag filters</summary>
            <label>Match included tags<select name="tagMode"><option value="all">All selected tags</option><option value="any">Any selected tag</option></select></label>
            <label>Find a tag<input type="search" id="catalog-tag-search" placeholder="Search tags…" autocomplete="off" /></label>
            <label>Tag group<select id="catalog-tag-group"><option value="">All groups</option>{groups.map(group => <option>{group}</option>)}</select></label>
            <p class="fine">Counts are Hunmeng novels. Excluded tags always remove a book.</p>
            <p id="tag-selection-count" class="fine" role="status" aria-live="polite">No tags selected.</p>
            <fieldset class="tag-picker">
              <legend>Include or exclude tags</legend>
              <div class="tag-picker-head" aria-hidden="true"><span>Tag</span><span>Include</span><span>Exclude</span></div>
              <div class="tag-picker-list" tabindex="0" role="region" aria-label="Available tags">
                {pickerTags.map(tag => <div class="tag-picker-row" data-tag-label={tag.label} data-tag-group={tag.group}>
                  <span>{tag.label} <small>({tag.count})</small></span>
                  <label><span class="sr-only">Include {tag.label}</span><input type="checkbox" name="include" value={tag.label} /></label>
                  <label><span class="sr-only">Exclude {tag.label}</span><input type="checkbox" name="exclude" value={tag.label} /></label>
                </div>)}
              </div>
              <p id="tag-picker-empty" class="fine" hidden>No matching tags.</p>
            </fieldset>
          </details>
        </details>
        <script is:inline>
          // Desktop opens its sidebar during parsing. Mobile starts compact; no zoom overrides.
          document.getElementById('catalog-options').open = !matchMedia('(max-width: 760px)').matches;
        </script>
      </form>
      <div class="catalog-main">
        <div class="results-heading catalog-results-heading">
          <p id="result-count" role="status" aria-live="polite">Novels found: {catalogItems.length}</p>
          <span id="catalog-load-status" class="catalog-load-status" role="status" aria-live="polite" hidden>Updating catalog…</span>
          <p class="fine">External novels are clearly marked and link to their reading sources.</p>
        </div>
        <div id="catalog-results" class="novel-grid">
          {catalogItems.slice(0, PAGE_SIZE).map((novel) => <Fragment set:html={renderCatalogCard(novel)} />)}
        </div>
        <p id="catalog-empty" class="empty-state" hidden={catalogItems.length > 0}>{catalogItems.length ? 'Nothing found. Try removing some filters.' : 'No novels are published yet. New releases will appear here.'}</p>
        <nav id="catalog-pagination" class="catalog-pagination" aria-label="Catalog pages" hidden></nav>
        <noscript>
          <p class="notice">Interactive search requires JavaScript. The first novels are shown above; you can browse the full catalog using the page links.</p>
          {catalogItems.length > PAGE_SIZE && <a class="button secondary" href="/catalog/page/2/">Next catalog page →</a>}
        </noscript>
      </div>
    </div>
  </main>
  <script>
    import { initCatalog } from '../scripts/catalog';
    void initCatalog();
  </script>
</Layout>
