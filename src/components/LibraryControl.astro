---
import { shelves } from '../config/site';
import Icon from './Icon.astro';
interface Props {
  slug: string;
  withIcon?: boolean;
}
const { slug, withIcon = false } = Astro.props;
---

<div class="library-control" data-library-control data-slug={slug}>
  <button class="button secondary" type="button" data-add-library>
    {withIcon && <Icon name="bookmark" size={18} />}
    Add to library
  </button>
  <label class="shelf-picker" hidden>
    Shelf
    <select data-shelf aria-label="Library shelf">
      {Object.entries(shelves).map(([value, label]) => (
        <option value={value}>{label}</option>
      ))}
      <option value="remove">Remove from library</option>
    </select>
  </label>
</div>
