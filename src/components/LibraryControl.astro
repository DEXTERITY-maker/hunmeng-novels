---
import { shelves } from '../config/site';
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<div class="library-control" data-library-control data-slug={slug}>
  <button class="button secondary" type="button" data-add-library>
    В библиотеку
  </button>
  <label class="shelf-picker" hidden>
    Полка
    <select data-shelf aria-label="Полка в библиотеке">
      {Object.entries(shelves).map(([value, label]) => (
        <option value={value}>{label}</option>
      ))}
      <option value="remove">Убрать из библиотеки</option>
    </select>
  </label>
</div>
