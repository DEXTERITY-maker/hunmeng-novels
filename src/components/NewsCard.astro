---
import { getLibrary } from '../lib/content';
import { dateLabel } from '../lib/content';
import { newsCategories, newsUrl, type NewsPost } from '../lib/news';

interface Props {
  post: NewsPost;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
const { title, excerpt, publishedAt, category } = post.data;
const linkedNovel = !compact && (await getLibrary()).find(n => title.toLowerCase().includes(n.title.toLowerCase()));
const newsArt: Record<string,string> = {
  'reader-profile-october-2026':'/images/ranks/mythical.svg',
  'reader-achievements-october-2026':'/images/ranks/diamond.svg',
  'reader-library-progress-october-2026':'/images/profile-kingdom.svg',
};
const image = linkedNovel ? linkedNovel.cover : (newsArt[post.id] ?? '/images/reading-landscape.webp');
const emblem = !linkedNovel && image.startsWith('/images/ranks/');
---
<article class:list={['news-card', compact && 'news-card-compact']} data-news-card data-news-category={category}>
  {!compact && <a class:list={["news-card-image", !linkedNovel && "news-card-landscape", emblem && "news-card-ornament"]} href={newsUrl(post.id)} tabindex="-1" aria-hidden="true"><img src={image} alt="" width="220" height="280" loading="lazy" /></a>}
  <div class="news-card-body"><div class="news-card-top">
    <span class:list={['news-category', `news-category-${category}`]}>{newsCategories[category]}</span>
    <time datetime={publishedAt}>{dateLabel(publishedAt)}</time>
  </div>
  <h3><a href={newsUrl(post.id)}>{title}</a></h3>
  <p>{excerpt}</p>
  <a class="news-read-more" href={newsUrl(post.id)}>Читать далее <span aria-hidden="true">→</span></a></div>
</article>
