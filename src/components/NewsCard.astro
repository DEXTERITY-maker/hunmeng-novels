---
import { dateLabel, getLibrary } from '../lib/content';
import { newsCategories, newsUrl, type NewsPost } from '../lib/news';

interface Props {
  post: NewsPost;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
const { title, excerpt, publishedAt, category } = post.data;
const relatedNovel = (await getLibrary()).find(n => post.body?.includes(`/novel/${n.slug}/`));
const image = relatedNovel?.cover ?? (post.id === 'hunmeng-opens' ? '/images/reading-landscape.webp' : undefined);
---
<article class:list={['news-card', compact && 'news-card-compact']} data-news-card data-news-category={category}>
  {!compact && image && <a class:list={['news-image', !relatedNovel && 'news-image-landscape']} href={newsUrl(post.id)} aria-hidden="true" tabindex="-1"><img src={image} alt="" width="180" height="240" loading="lazy" decoding="async" /></a>}
  <div class="news-card-top">
    <span class:list={['news-category', `news-category-${category}`]}>{newsCategories[category]}</span>
    <time datetime={publishedAt}>{dateLabel(publishedAt)}</time>
  </div>
  <h3><a href={newsUrl(post.id)}>{title}</a></h3>
  <p>{excerpt}</p>
  <a class="news-read-more" href={newsUrl(post.id)}>Read more <span aria-hidden="true">→</span></a>
</article>
