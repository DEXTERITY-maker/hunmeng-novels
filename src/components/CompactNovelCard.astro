---
import { chapterCount, type Novel } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  novel: Novel;
}
const { novel: n } = Astro.props;
---

<article class="home-book-card">
  <a class="home-book-link" href={n.url} aria-label={'View novel “' + n.title + '”'}>
    <span class="home-book-cover">
      <img src={n.cover} alt="" width="260" height="380" loading="lazy" decoding="async" />
    </span>
    <span class="home-book-copy">
    <span class="home-book-genre">{n.genres.join(' · ')}</span>
    <h3 class="home-book-title">{n.title}</h3>
    <span class="home-book-author">By {n.author}</span>
    <span class="home-book-description">{n.description}</span>
    <span class="home-book-meta">{chapterCount(n.chapterCount)} · {n.translationStatus}</span>
    <span class="home-book-read">Read novel <Icon name="arrow" size={17} /></span>
    </span>
  </a>
</article>
