---
import Icon from './Icon.astro';
---
<div class="page-heading catalog-heading landscape-banner catalog-art-hero">
  <span class="eyebrow">EXPLORE YOUR NEXT WORLD <span aria-hidden="true">✦</span></span>
  <h1>Novel <em>catalog</em></h1>
  <p>Search and filter for a story to match your mood.</p>
  <nav class="taxonomy-nav catalog-hero-actions" aria-label="Browse novels">
    <a href="/genres/" class="catalog-genres-link"><Icon name="layers" size={20} /> Browse genres <span aria-hidden="true">→</span></a>
    <a href="/tags/" class="catalog-tags-link"><Icon name="tag" size={20} /> Browse tags <span aria-hidden="true">→</span></a>
  </nav>
</div>
