---
import { dateLabel, chapterCount, type Novel } from '../lib/content';
interface Props {
  novel: Novel;
}
const { novel: n } = Astro.props;
---

<article class="novel-card catalog-novel-card" data-novel={n.slug}>
  <a class="cover-link" href={n.url} tabindex="-1" aria-hidden="true">
    <img src={n.cover} alt="" width="260" height="380" loading="lazy" />
  </a>
  <div class="novel-copy">
    <p class="genre-line">{n.categories.length ? n.categories.join(' · ') : n.genres.join(' · ')}</p>
    <h2><a href={n.url}>{n.title}</a></h2>
    <p class="original-title">{n.originalTitle} · {n.author}</p>
    <p class="card-description">{n.description}</p>
    <p class="catalog-card-stats">
      <span>★ {n.rating ? `${n.rating.average.toFixed(1)} / 5 · ${n.rating.count} оценок` : 'Нет оценок'}</span>
      <span>◉ {typeof n.views === 'number' ? `${new Intl.NumberFormat('ru-RU').format(n.views)} просмотров` : 'Нет данных о просмотрах'}</span>
    </p>
    <p class="fine">
      {chapterCount(n.chapterCount)} · {n.translationStatus} ·{' '}
      <time datetime={n.updatedAt}>{dateLabel(n.updatedAt)}</time>
    </p>
    <a class="text-link" href={n.url}>Открыть новеллу <span aria-hidden="true">→</span></a>
  </div>
</article>
