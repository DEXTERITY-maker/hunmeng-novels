---
import Icon from './Icon.astro';
import { chapterCount, type Novel } from '../lib/content';
interface Props {
  novel: Novel;
}
const { novel: n } = Astro.props;
const updated = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(n.updatedAt));
---

<article class="novel-card catalog-novel-card" data-novel={n.slug} data-art={n.art}>
  {n.art && <div class="catalog-card-art" aria-hidden="true"></div>}
  <a class="cover-link" href={n.url} tabindex="-1" aria-hidden="true">
    <img src={n.cover} alt="" width="260" height="380" loading="lazy" />
  </a>
  <div class="novel-copy">
    <p class="genre-line">{n.genres.join(' · ')}</p>
    <h2><a href={n.url}>{n.title}</a></h2>
    <p class="original-title">{n.originalTitle === n.title ? n.author : `${n.originalTitle} · ${n.author}`}</p>
    <p class="card-description">{n.description}</p>
    {n.tags.length > 0 && <div class="catalog-card-tags" aria-label="Story tags">
      {n.tags.slice(0, 3).map(tag => <a href={`/catalog/?include=${encodeURIComponent(tag)}`}>{tag}</a>)}
    </div>}
    {(n.rating || typeof n.views === 'number') && <p class="catalog-card-stats">
      {n.rating && <span>★ {n.rating.average.toFixed(1)} / 5 · {n.rating.count} ratings</span>}
      {typeof n.views === 'number' && <span>◉ {new Intl.NumberFormat('en-US').format(n.views)} views</span>}
    </p>}
    <p class="catalog-card-meta fine">
      <span class="catalog-meta-chapters"><Icon name="book" size={17} /> {n.chapterCount} chapters</span>
      <span class="catalog-meta-status"><span class:list={['catalog-status-dot', n.originalStatus === 'Ongoing' && 'is-ongoing']} aria-hidden="true"></span>{n.originalStatus}<span class="catalog-translation-status sr-only"> Translation: {n.translationStatus}</span></span>
      <span class="catalog-meta-updated"><Icon name="clock" size={17} /> Updated <time datetime={n.updatedAt}>{updated}</time></span>
    </p>
  </div>
  <a class="text-link catalog-read-action" href={n.url}>Read novel <span aria-hidden="true">→</span></a>
</article>
