---
import { ranks,readerMasteryTiers,titles,achievements,rankImage,masteryImage } from '../lib/reader-progression';
---
<div id="reader-advancement" class="reader-advancement" data-status="loading" aria-label="Reader progression">
  <p id="reader-advancement-status" class="fine" role="status" aria-live="polite">Loading verified reading achievements…</p>
  <section class="advancement-stats" aria-label="Verified reading statistics" hidden>
    <div><span>Chapters</span><strong id="reader-stat-chapters">—</strong></div>
    <div><span>Novels finished</span><strong id="reader-stat-novels">—</strong></div>
    <div><span>Reading days</span><strong id="reader-stat-days">—</strong></div>
    <div><span>Achievements</span><strong id="reader-stat-achievements">— / {achievements.length}</strong></div>
  </section>
  <div class="profile-legacy-stats" hidden aria-hidden="true">
    <span id="reader-stat-collection">—</span><span id="reader-stat-reviews">—</span>
    <span id="reader-stat-reading">0</span><span id="reader-stat-later">0</span>
    <span id="reader-stat-shelf-completed">0</span>
  </div>
  <div class="profile-inner-tabs" role="tablist" aria-label="Profile information">
    <button type="button" id="profile-tab-overview" role="tab" aria-selected="true" tabindex="0" aria-controls="overview" data-overview-tab="overview">Overview</button>
    <button type="button" id="profile-tab-progress" role="tab" aria-selected="false" tabindex="-1" aria-controls="progress" data-overview-tab="progress">Progress</button>
    <button type="button" id="profile-tab-titles-achievements" role="tab" aria-selected="false" tabindex="-1" aria-controls="titles-achievements" data-overview-tab="titles-achievements">Titles &amp; achievements</button>
    <button type="button" id="profile-tab-xp-history" role="tab" aria-selected="false" tabindex="-1" aria-controls="xp-history" data-overview-tab="xp-history">XP history</button>
  </div>
  <div id="overview" class="profile-inner-panel profile-overview-grid" role="tabpanel" aria-labelledby="profile-tab-overview" tabindex="0">
    <slot name="recent-reading" />
    <section class="profile-overview-card profile-goal-card" aria-labelledby="profile-goal-heading">
      <h3 id="profile-goal-heading">Next goal</h3>
    <div id="reader-next-achievement" class="reader-next-achievement" hidden>
      <p class="eyebrow">Closest milestone</p>
      <h4 id="reader-next-achievement-name">Next achievement</h4>
      <p id="reader-next-achievement-description" class="fine"></p>
      <progress id="reader-next-achievement-progress" max="1" value="0" aria-label="Progress to the next achievement"></progress>
      <small id="reader-next-achievement-remaining"></small>
    </div>
    <p id="reader-all-achievements" class="reader-all-achievements fine" hidden>All verified milestones unlocked. Explore more worlds as they arrive.</p>

    </section>
  <section id="halloween-profile-awards-section" class="advancement-section" aria-labelledby="halloween-profile-awards-heading" hidden>
    <div class="advancement-section-header"><p class="eyebrow">✦ SPECIAL EVENT REWARDS</p><h3 id="halloween-profile-awards-heading">Event awards</h3><p>Verified event awards and their selectable titles.</p></div>
    <div id="halloween-profile-awards" class="halloween-profile-awards"></div>
    <p id="profile-event-cta" hidden><a href="/events/halloween-2026/">Halloween Reading Week is on <span aria-hidden="true">→</span></a></p>
    <p id="halloween-profile-awards-status" class="fine" role="status" aria-live="polite"></p>
  </section>

    <section class="profile-overview-card profile-recent-xp-card" aria-labelledby="profile-recent-xp-heading">
      <div class="profile-card-heading"><h3 id="profile-recent-xp-heading">Recent XP</h3>
        <a href="#xp-history" id="profile-view-xp-history">View history <span aria-hidden="true">→</span></a>
      </div>
      <p id="reader-recent-xp-status" class="fine" role="status">Checking verified rewards…</p>
      <ol id="reader-recent-xp-list" class="reader-xp-history-list" aria-label="Three latest verified XP awards"></ol>
    </section>
  </div>
  <div id="progress" class="profile-inner-panel profile-progress-content" role="tabpanel" aria-labelledby="profile-tab-progress" tabindex="0" hidden>
    <section class="advancement-section profile-rank-progress-card" aria-labelledby="profile-rank-progress-title">
      <h3 id="profile-rank-progress-title">Reader ranks</h3>
      <div class="profile-current-next-ranks">
        <div class="profile-current-rank">
          <img id="profile-progress-current-emblem" src="/images/ranks/iron.svg" width="54" height="60" alt="Current rank emblem" />
          <span><small>Current rank</small><strong id="profile-progress-current-name">Iron</strong></span>
        </div>
      <div id="reader-next-rank" class="reader-next-rank" hidden>
        <img id="reader-next-rank-image" src={rankImage('bronze')} width="54" height="60" alt="Next rank emblem" loading="lazy" />
        <div class="reader-next-rank-copy">
          <span class="fine">Next rank</span>
          <strong id="reader-next-rank-name">Bronze · Level 25</strong>
          <small id="reader-next-rank-remaining">Loading verified XP…</small>
          <progress id="reader-next-rank-progress" max="1" value="0" aria-label="Verified experience toward next reader rank"></progress>
        </div>
      </div>
      <p id="reader-highest-rank" class="fine reader-highest-rank" hidden>Highest rank unlocked: Mythical. Keep reading toward level 500.</p>

      </div>
      <a class="advancement-all-ranks" href="/ranks/">All nine ranks <span aria-hidden="true">→</span></a>
    </section>
  <section class="advancement-section reader-mastery-section" aria-labelledby="reader-mastery-heading" hidden>
    <div class="advancement-section-header"><p class="eyebrow">✦ SIX MASTERY STEPS</p><h3 id="reader-mastery-heading">Reader's Path</h3><p>Six mastery steps follow your verified level. They are separate from the nine visual ranks and selectable titles.</p></div>
    <div class="reader-mastery-grid">
      {readerMasteryTiers.map(tier=>(
        <article class="reader-mastery-tile" data-mastery-id={tier.id} data-mastery-min={tier.min}>
          <div class="reader-mastery-emblem-wrap">
            <img class="reader-mastery-emblem" src={masteryImage(tier.id)} alt={`Illustrated emblem for ${tier.en}`} width="640" height="640" loading="lazy" decoding="async" />
          </div>
          <strong>{tier.en}</strong>
          <span class="reader-mastery-levels">Levels {tier.min}–{tier.max}</span>
          <small data-mastery-state>Locked</small>
        </article>
      ))}
    </div>
  </section>

    <div class="rank-gallery" hidden aria-hidden="true">
      {ranks.map(rank => (<span class="rank-tile" data-rank-id={rank.id} data-rank-min={rank.min}><span data-rank-state>Locked</span></span>))}
    </div>
  </div>
  <div id="titles-achievements" class="profile-inner-panel profile-titles-content" role="tabpanel" aria-labelledby="profile-tab-titles-achievements" tabindex="0" hidden>
  <section class="advancement-section" aria-labelledby="reader-titles-heading" hidden>
    <div class="advancement-section-header"><p class="eyebrow">✦ SPECIAL TITLES</p><h3 id="reader-titles-heading">Titles</h3><p>Unlock titles through verified achievements and choose which one to display in your profile. Titles are independent of visual ranks.</p></div>
    <div class="reader-awards-list">
      {titles.map(t => (
        <article class="reader-award" data-title-id={t.id}>
          <div class="award-symbol" aria-hidden="true">✦</div>
          <div class="award-body"><h4>{t.en}</h4><p>{t.description}</p>
            <progress max={Math.max(1,t.target)} value="0" aria-label={`${t.en} unlock progress`}></progress>
            <small data-award-progress>Checking progress…</small>
          </div>
          <button type="button" class="button secondary award-select" data-equip-title={t.id} disabled>Locked</button>
        </article>
      ))}
    </div>
    <p id="reader-title-status" class="fine" role="status" aria-live="polite"></p>
  </section>
  <section class="advancement-section" aria-labelledby="reader-achievements-heading" hidden>
    <div class="advancement-section-header"><p class="eyebrow">✦ YOUR STORY MILESTONES</p><h3 id="reader-achievements-heading">Achievements</h3><p>Achievements are based on verified activity and do not award extra XP.</p></div>
    <div class="achievement-filter" role="group" aria-label="Filter achievements">
      <button type="button" data-achievement-filter="all" aria-pressed="true">All</button>
      <button type="button" data-achievement-filter="unlocked" aria-pressed="false">Unlocked</button>
      <button type="button" data-achievement-filter="locked" aria-pressed="false">Locked</button>
    </div>
    <p id="reader-achievements-summary" class="fine" aria-live="polite">Checking verified achievements…</p>
    <div class="reader-achievements-grid">
      {achievements.map((a,i) => (
        <article class="achievement-tile" data-achievement-id={a.id}>
          <div class="achievement-icon" aria-hidden="true">{['✧','❖','✦','◈','✶','✵','✻'][i % 7]}</div>
          <h4>{a.en}</h4><p>{a.description}</p>
          <progress value="0" max={a.target} aria-label={`${a.en} achievement progress`}></progress>
          <span data-achievement-status>Checking…</span>
        </article>
      ))}
    </div>
    <p id="reader-achievements-empty" class="fine" hidden>No achievements match this filter yet.</p>
  </section>

  </div>
  <div id="xp-history" class="profile-inner-panel" role="tabpanel" aria-labelledby="profile-tab-xp-history" tabindex="0" hidden>
  <section class="advancement-section" aria-labelledby="reader-xp-history-heading" hidden>
    <div class="advancement-section-header"><p class="eyebrow">Verified rewards</p><h3 id="reader-xp-history-heading">XP history</h3><p>Experience earned from confirmed reading activity, stored with your account.</p></div>
    <p id="reader-xp-history-status" class="fine" role="status">Loading your reward history…</p>
    <ol id="reader-xp-history-list" class="reader-xp-history-list" aria-label="Recent verified XP awards"></ol>
  </section>

  </div>
</div>
<dialog id="reader-mastery-unlocked" class="reader-mastery-dialog" aria-labelledby="reader-mastery-unlocked-title" aria-describedby="reader-mastery-unlocked-detail">
  <div class="reader-mastery-dialog-inner">
    <p class="reader-mastery-dialog-eyebrow">✦ HUNMENG · READER'S PATH ✦</p>
    <div class="reader-mastery-dialog-emblem">
      <img id="reader-mastery-unlocked-image" src={masteryImage('novice')} alt="New Reader's Path emblem" width="640" height="640" decoding="async" />
    </div>
    <h2 id="reader-mastery-unlocked-title">New mastery step unlocked!</h2>
    <p id="reader-mastery-unlocked-detail">Your reading journey continues.</p>
    <button type="button" id="reader-mastery-acknowledge" class="button">Continue reading</button>
  </div>
</dialog>
<dialog id="reader-rank-unlocked" class="reader-rank-dialog" aria-labelledby="reader-new-rank-title">
  <div class="reader-rank-dialog-inner">
    <p class="eyebrow">A new chapter in your journey</p>
    <img id="reader-new-rank-image" width="155" height="176" alt="" />
    <h2 id="reader-new-rank-title">Congratulations!</h2>
    <p id="reader-new-rank-detail"></p>
    <button type="button" id="reader-rank-acknowledge" class="button">Continue reading</button>
  </div>
</dialog>
