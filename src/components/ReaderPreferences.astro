<section id="profile-reading" class="profile-panel" aria-labelledby="preferences-title">
  <h2 id="preferences-title">Reading settings</h2>
  <p class="profile-intro">Make the text comfortable for you. These settings apply on this device.</p>
  <form id="preferences-form">
    <div class="preference-grid">
      <label>Appearance<select name="theme" aria-label="Appearance"><option value="system">System default</option><option value="light">Light</option><option value="dark">Dark</option><option value="sepia">Sepia</option></select></label>
      <label>Reading font<select name="font" aria-label="Reading font"><option value="serif">Serif</option><option value="sans">Sans serif</option><option value="system">System</option></select></label>
      <label>Text size <output id="pref-size-value">20 px</output><input name="size" type="range" min="16" max="32" step="1" value="20" /></label>
      <label>Line height <output id="pref-leading-value">1.85</output><input name="lineHeight" type="range" min="1.4" max="2.4" step="0.05" value="1.85" /></label>
      <label class="preference-wide">Column width <output id="pref-width-value">720 px</output><input name="width" type="range" min="480" max="960" step="20" value="720" /></label>
      <label class="preference-wide">Paragraph spacing <output id="pref-paragraph-value">1.35 em</output><input name="paragraphSpacing" type="range" min="0.65" max="2.2" step="0.05" value="1.35" /></label>
    </div>
    <div id="preferences-preview" class="preferences-preview" aria-label="Text preview">Morning light fell across the page. Every story holds a new world, waiting to be discovered.</div>
    <div class="account-actions"><button type="submit" class="button">Save settings</button><button type="button" id="preferences-reset" class="button secondary">Reset to default</button></div>
    <p id="preferences-status" class="fine" role="status" aria-live="polite"></p>
  </form>
</section>
