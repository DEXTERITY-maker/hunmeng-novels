<section id="profile-reading" class="profile-panel" aria-labelledby="preferences-title">
  <h2 id="preferences-title">Настройки чтения</h2>
  <p class="profile-intro">Настройте текст так, как удобно вам. Эти параметры действуют на этом устройстве.</p>
  <form id="preferences-form">
    <div class="preference-grid">
      <label>Тема оформления<select name="theme" aria-label="Тема оформления"><option value="system">Как в системе</option><option value="light">Светлая</option><option value="dark">Тёмная</option><option value="sepia">Сепия</option></select></label>
      <label>Шрифт читалки<select name="font" aria-label="Шрифт читалки"><option value="serif">С засечками</option><option value="sans">Без засечек</option><option value="system">Системный</option></select></label>
      <label>Размер текста <output id="pref-size-value">20 px</output><input name="size" type="range" min="16" max="32" step="1" value="20" /></label>
      <label>Межстрочный интервал <output id="pref-leading-value">1,85</output><input name="lineHeight" type="range" min="1.4" max="2.4" step="0.05" value="1.85" /></label>
      <label class="preference-wide">Ширина колонки <output id="pref-width-value">720 px</output><input name="width" type="range" min="480" max="960" step="20" value="720" /></label>
    </div>
    <div id="preferences-preview" class="preferences-preview" aria-label="Пример текста">Лучи утреннего света коснулись страницы. В каждой истории скрыт новый мир, который ждёт, чтобы его прочитали.</div>
    <div class="account-actions"><button type="submit" class="button">Сохранить настройки</button><button type="button" id="preferences-reset" class="button secondary">По умолчанию</button></div>
    <p id="preferences-status" class="fine" role="status" aria-live="polite"></p>
  </form>
</section>
