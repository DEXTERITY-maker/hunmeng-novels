---
interface Props { name: 'search' | 'arrow' | 'sun' | 'moon' | 'system' | 'sepia' | 'user' | 'book' | 'bookmark' | 'layers' | 'tag' | 'clock' | 'check' | 'ban' | 'chevron' | 'info' | 'shield' | 'pen' | 'logout' | 'sliders'; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'search' && <><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></>}
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'sun' && <><circle cx="12" cy="12" r="3.8" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'moon' && <path d="M20.5 14A8.6 8.6 0 0 1 10 3.5 8.6 8.6 0 1 0 20.5 14Z" />}
  {name === 'system' && <><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></>}
  {name === 'sepia' && <><path d="M5 3h14v18H5Z" /><path d="M9 7h6m-6 5h6m-6 5h4" /></>}
  {name === 'user' && <><circle cx="12" cy="8" r="3.5" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></>}
  {name === 'book' && <><path d="M12 5.5C8.5 3.7 5 3.8 2.5 5v14c2.5-1.2 6-1.3 9.5.5 3.5-1.8 7-1.7 9.5-.5V5C19 3.8 15.5 3.7 12 5.5Z" /><path d="M12 5.5v14" /></>}
  {name === 'layers' && <><path d="m12 3 10 5-10 5L2 8l10-5Z" /><path d="m2 12 10 5 10-5M2 16l10 5 10-5" /></>}
  {name === 'tag' && <><path d="M3 3h8l10 10-8 8L3 11V3Z" /><circle cx="7.5" cy="7.5" r="1" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 6v6h5" /></>}
  {name === 'check' && <><circle cx="12" cy="12" r="9" /><path d="m7 12 3 3 7-7" /></>}
  {name === 'ban' && <><circle cx="12" cy="12" r="9" /><path d="m6 6 12 12" /></>}
  {name === 'chevron' && <path d="m9 5 7 7-7 7" />}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v5m0-9h.01" /></>}
  {name === 'shield' && <path d="M12 2 21 6v5c0 6-3.5 9-9 11-5.5-2-9-5-9-11V6l9-4Zm-4 10 3 3 5-6" />}
  {name === 'pen' && <><path d="m4 20 5.5-1.2L20 8.3 15.7 4 5.2 14.5 4 20Z" /><path d="m13.8 6 4.3 4.3M4 20l5.5-1.2" /></>}
  {name === 'logout' && <><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5" /><path d="M14 7l5 5-5 5M8 12h11" /></>}
  {name === 'sliders' && <><path d="M4 5h16M4 12h16M4 19h16" /><circle cx="9" cy="5" r="2" fill="var(--surface)" /><circle cx="16" cy="12" r="2" fill="var(--surface)" /><circle cx="11" cy="19" r="2" fill="var(--surface)" /></>}
  {name === 'bookmark'  && <path d="M6 3h12v18l-6-4-6 4V3Z" />}
</svg>
