---
import ContinueReading from './ContinueReading.astro';
import { getLibrary, chapterCount, dateLabel } from '../lib/content';
import { getLatestChapters } from '../lib/updates';
import { getNews, newsUrl, newsCover } from '../lib/news';
import { getTaxonomy } from '../lib/taxonomy';
import { site } from '../config/site';
import { unpublishedExternalEntries } from '../lib/external-catalog';
import '../styles/v2-home.css';
import '../styles/v3-editorial.css';

// Hunmeng 2.0 is a read-only design pilot: production sources and URLs remain canonical.
const novels = await getLibrary();
const featured = novels[0];
const selection = [...novels]
  .sort((a, b) => (b.addedAt ?? b.updatedAt).localeCompare(a.addedAt ?? a.updatedAt))
  .slice(0, 6);
const latestChapters = getLatestChapters(novels).slice(0, 4);
const latestNews = (await getNews()).slice(0, 3);
const external = unpublishedExternalEntries(novels.map(n => n.slug)).slice(0, 2);
const genres = [...new Set(novels.flatMap(n => n.genres))].slice(0, 6);
const chapterTotal = novels.reduce((count, novel) => count + novel.chapterCount, 0);
const number = new Intl.NumberFormat('en-US');
// These rows are navigation aids, not an invented stock of books. The counts
// come only from published records already in the Hunmeng library.
const taxonomy = getTaxonomy(novels);
const categoryChoices = [
  { title: 'Fantasy & Adventure', genre: 'Fantasy', symbol: '✧', tone: 'vermilion' },
  { title: 'Mystery & Suspense', genre: 'Mystery', symbol: '◈', tone: 'earth' },
  { title: 'Historical Stories', genre: 'Historical', symbol: '✦', tone: 'gold' },
  { title: 'Science Fiction', genre: 'Science fiction', symbol: '◇', tone: 'sage' },
  { title: 'Romance & Drama', genre: 'Romance', symbol: '❦', tone: 'leaf' },
  { title: 'Martial Arts', genre: 'Martial arts', symbol: '△', tone: 'teal' },
].map(item => ({ ...item, count: taxonomy.genres.find(term => term.label === item.genre)?.count ?? 0 }));
const themedCollections = [
  { title: 'Fantasy & Wonder', description: 'Other worlds to wander', genre: 'Fantasy', art: '/images/editorial/collection-fantasy.webp' },
  { title: 'Mystery & Intrigue', description: 'Stories with secrets', genre: 'Mystery', art: '/images/editorial/collection-mystery.webp' },
  { title: 'Worlds of Tomorrow', description: 'Beyond the horizon', genre: 'Science fiction', art: '/images/editorial/collection-future.webp' },
];

interface Props { launched?: boolean }
const { launched = false } = Astro.props;
const catalogPath = launched ? '/catalog/' : '/v2/catalog/';
---
<main id="main" class="v2-home v3-art-direction">
    <div class="v2-shell">
      {!launched && (
        <div class="v2-preview-bar">
          <span class="v2-preview-label"><span class="v2-preview-dot" aria-hidden="true"></span> Hunmeng 2.0 · Design preview</span>
          <a href="/">Return to the current website <span aria-hidden="true">↗</span></a>
        </div>
      )}

      <nav class="v3-primary-nav" aria-label="Reading room navigation">
        <a href={launched ? '/' : '/v2/'} aria-current="page">Home</a>
        <a href={catalogPath}>Books</a>
        <a href="/news/">Articles</a>
        <a href="#v3-collections">Collections</a>
        <a href="/about/">About</a>
      </nav>
      <section class="v2-hero" aria-labelledby="v2-hero-title">
        <div class="v2-hero-copy">
          <p class="v2-kicker">HUNMENG DIGITAL LIBRARY <span aria-hidden="true">✦</span></p>
          <h1 id="v2-hero-title">A thousand worlds.<br /><em>One quiet place.</em></h1>
          <p class="v2-lead">Thoughtful books, timeless ideas, a calmer you.</p>
          <form class="v2-search" role="search" action={catalogPath} method="get">
            <label class="v2-visually-hidden" for="v2-search-input">Search by title or author</label>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="7.2"/><path d="m16 16 5 5"/></svg>
            <input id="v2-search-input" name="search" type="search" placeholder="Search books, authors, or topics" autocomplete="off" required />
            <button type="submit" aria-label="Find a story">Search <span aria-hidden="true">↗</span></button>
          </form>
          <nav class="v3-hero-chips" aria-label="Discover your next read"><a href={catalogPath + '?sort=added'}><span aria-hidden="true">✦</span> New arrivals</a><a href="/genres/"><span aria-hidden="true">✧</span> Browse genres</a><a href="/library/"><span aria-hidden="true">♡</span> My library</a></nav>
          <div class="v2-hero-foot">
            <span><strong>{number.format(novels.length)}</strong> published books</span>
            <span class="v2-foot-divider" aria-hidden="true"></span>
            <span><strong>{number.format(chapterTotal)}</strong> chapters to explore</span>
          </div>
        </div>
        <div class="v2-hero-visual">
          <div class="v2-hero-art" aria-hidden="true"></div>
          {featured ? (
            <article class="v2-spotlight" aria-label="Featured reading">
              <div class="v2-spotlight-heading"><span class="v2-spotlight-mark">✦</span><span>FEATURED BOOK</span><span class="v2-spotlight-index">01 / {number.format(novels.length)}</span></div>
              <div class="v2-spotlight-body">
                <a href={featured.url} class="v2-spotlight-cover" aria-label={'Explore ' + featured.title}>
                  <img src={featured.cover} alt="" width="230" height="335" loading="eager" fetchpriority="high" />
                </a>
                <div class="v2-spotlight-details">
                  <p class="v2-spotlight-genre">{featured.genres.slice(0, 2).join(' · ')}</p>
                  <h2><a href={featured.url}>{featured.title}</a></h2>
                  <p class="v2-spotlight-author">by {featured.author}</p>
                  <p class="v3-feature-summary">{featured.description}</p>
                  <p class="v2-spotlight-meta">{chapterCount(featured.chapterCount)}</p>
                  <div class="v3-feature-actions"><a class="v2-spotlight-link" aria-label="Try the V2 reader" href={launched ? featured.firstUrl : `/v2/read/${encodeURIComponent(featured.slug)}/${encodeURIComponent(featured.chapters[0].data.slug)}/`}>Read more <span aria-hidden="true">→</span></a><a class="v3-feature-secondary" href="/library/">My library ♡</a></div>
                </div>
              </div>
            </article>
          ) : (
            <div class="v2-spotlight v2-spotlight-empty">
              <span aria-hidden="true">✦</span>
              <strong>Good stories take time.</strong>
              <p>New books will be featured here when they are published.</p>
              <a href={catalogPath}>Explore the catalog <span aria-hidden="true">↗</span></a>
            </div>
          )}
        </div>
      </section>

      <aside class="v3-welcome" aria-label="Welcome to Hunmeng">
        <div class="v3-welcome-illustration" aria-hidden="true"></div>
        <div><p>WELCOME TO YOUR READING ROOM</p><h2>Welcome to Hunmeng</h2><span>Where good books meet a slower, richer life.</span></div>
        <a href="/about/" aria-label="About Hunmeng"><span aria-hidden="true">→</span></a>
      </aside>
      {launched && (
        <aside id="halloween-home-banner" class="halloween-home-banner" hidden aria-label="Halloween Reading Week event">
          <img class="halloween-home-banner-symbol" src="/images/events/halloween-2026/gold-128.webp" alt="" width="56" height="56" decoding="async" />
          <div><strong>Halloween Reading Week</strong><p>1–7 November · Read chapters, climb the leaderboard and earn a special award.</p></div>
          <a href="/events/halloween-2026/">View event <span aria-hidden="true">→</span></a>
        </aside>
      )}
      {launched && <ContinueReading />}
      <section class="v3-categories" aria-labelledby="v3-categories-title">
        <div class="v3-section-heading"><h2 id="v3-categories-title">Explore by Category</h2><a href="/genres/">View all categories <span aria-hidden="true">→</span></a></div>
        <div class="v3-category-list">
          {categoryChoices.map(item => (
            <a class="v3-category-row" href={catalogPath + '?genre=' + encodeURIComponent(item.genre)}>
              <span class:list={['v3-category-icon', 'v3-category-icon-' + item.tone]} aria-hidden="true">{item.symbol}</span>
              <span class="v3-category-description"><strong>{item.title}</strong><small>{item.count ? number.format(item.count) + (item.count === 1 ? ' book' : ' books') : 'Explore this genre'}</small></span>
              <span class="v3-category-arrow" aria-hidden="true">›</span>
            </a>
          ))}
        </div>
      </section>
      <section class="v3-collections" id="v3-collections" aria-labelledby="v3-collections-title">
        <div class="v3-section-heading"><div><h2 id="v3-collections-title">Curated Collections</h2><p>Discover stories by mood and theme.</p></div><a href="/genres/">Explore all <span aria-hidden="true">→</span></a></div>
        <div class="v3-collection-grid">
          {themedCollections.map(item => (
            <a class="v3-collection-card" href={catalogPath + '?genre=' + encodeURIComponent(item.genre)}>
              <img src={item.art} width="960" height="720" loading="lazy" decoding="async" alt="" />
              <span><strong>{item.title}</strong><small>{item.description} <span aria-hidden="true">→</span></small></span>
            </a>
          ))}
        </div>
      </section>
      <nav class="v2-discover" aria-label="Explore the reading room">
        <a href={catalogPath}><span class="v2-discover-symbol" aria-hidden="true">◈</span><span><strong>Browse the library</strong><small>All published books</small></span><span aria-hidden="true">↗</span></a>
        <a href="/genres/"><span class="v2-discover-symbol" aria-hidden="true">✧</span><span><strong>Explore genres</strong><small>Find your next world</small></span><span aria-hidden="true">↗</span></a>
        <a href="/updates/"><span class="v2-discover-symbol" aria-hidden="true">◷</span><span><strong>Latest chapters</strong><small>Pick up a new chapter</small></span><span aria-hidden="true">↗</span></a>
      </nav>

      <section class="v2-section" aria-labelledby="v2-shelf-title">
        <div class="v2-section-header">
          <div><p class="v2-section-eyebrow">HANDPICKED FROM PUBLISHED BOOKS</p><h2 id="v2-shelf-title">Editors’ Picks</h2></div>
          <a class="v2-text-link" href={catalogPath}>View all novels <span aria-hidden="true">↗</span></a>
        </div>
        {genres.length > 0 && (
          <nav class="v2-genre-strip" aria-label="Popular genres">
            <a class="v2-genre-all" href="/genres/">Genres <span aria-hidden="true">↗</span></a>
            {genres.map(genre => <a href={catalogPath + '?genre=' + encodeURIComponent(genre)}>{genre}</a>)}
          </nav>
        )}
        {selection.length ? (
          <div class="v2-book-grid">
            {selection.map((novel, index) => (
              <article class="v2-book">
                <a class="v2-book-cover" href={novel.url} aria-label={'View ' + novel.title}>
                  <img src={novel.cover} alt="" width="240" height="350" loading="lazy" decoding="async" />
                  <span class="v2-book-number">{String(index + 1).padStart(2, '0')}</span>
                </a>
                <p class="v2-book-genre">{novel.genres.slice(0, 2).join(' · ')}</p>
                <h3><a href={novel.url}>{novel.title}</a></h3>
                <p class="v2-book-byline">{novel.author}</p>
                <p class="v2-book-count">{chapterCount(novel.chapterCount)}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="v2-empty-state"><strong>The next great read is on its way.</strong><p>Published books will appear here as soon as they are available.</p><a href="/news/">Read library news →</a></div>
        )}
      </section>

      <div class="v2-editorial-grid">
        <section class="v2-section v2-updates" aria-labelledby="v2-updates-title">
          <div class="v2-section-header">
            <div><p class="v2-section-eyebrow">FRESH FROM THE LIBRARY</p><h2 id="v2-updates-title">New chapters</h2></div>
            <a class="v2-text-link" href="/updates/">All updates <span aria-hidden="true">↗</span></a>
          </div>
          {latestChapters.length ? (
            <ol class="v2-chapter-list">
              {latestChapters.map(chapter => (
                <li><a href={chapter.url} class="v2-chapter-row">
                  <span class="v2-chapter-thumbnail"><img src={chapter.cover} alt="" loading="lazy" width="58" height="80" decoding="async" /></span>
                  <span class="v2-chapter-copy"><small>{chapter.novel}</small><strong>Chapter {chapter.number}: {chapter.title}</strong><time datetime={chapter.date}>{dateLabel(chapter.date)}</time></span>
                  <span class="v2-row-arrow" aria-hidden="true">↗</span>
                </a></li>
              ))}
            </ol>
          ) : <p class="v2-empty-inline">Newly published chapters will appear here.</p>}
        </section>
        <section class="v2-section v2-news" aria-labelledby="v2-news-title">
          <div class="v2-section-header">
            <div><p class="v2-section-eyebrow">READING CULTURE & UPDATES</p><h2 id="v2-news-title">Latest Articles</h2></div>
            <a class="v2-text-link" href="/news/">All news <span aria-hidden="true">↗</span></a>
          </div>
          {latestNews.length ? (
            <div class="v2-news-list">
              {latestNews.map(post => (
                <article class="v2-news-item">
                  <a class="v3-article-image" href={newsUrl(post.id)} aria-label={'Read ' + post.data.title}><img src={newsCover(post, novels).src} alt="" width="96" height="96" loading="lazy" decoding="async" /></a>
                  <div class="v3-article-copy">
                    <p><span>{post.data.category === 'changelog' ? 'UPDATE' : 'NEWS'}</span><time datetime={post.data.publishedAt}>{dateLabel(post.data.publishedAt)}</time></p>
                    <h3><a href={newsUrl(post.id)}>{post.data.title}</a></h3>
                    <p class="v2-news-excerpt">{post.data.excerpt}</p>
                  </div>
                  <span class="v3-article-arrow" aria-hidden="true">›</span>
                </article>
              ))}
            </div>
          ) : <p class="v2-empty-inline">News from Hunmeng will appear here.</p>}
        </section>
      </div>

      {external.length > 0 && (
        <section class="v2-external" aria-labelledby="v2-external-title">
          <div><p class="v2-section-eyebrow">BEYOND THE LIBRARY</p><h2 id="v2-external-title">Explore external stories</h2>
            <p>Curated references to other reading platforms. These are not chapters hosted by Hunmeng.</p>
          </div>
          <ul>{external.map(item => <li><a href={item.url}>{item.title} <span aria-hidden="true">↗</span></a><small>{item.sourceName} · External listing</small></li>)}</ul>
        </section>
      )}

      <section class="v3-depth" aria-labelledby="v3-depth-title">
        <div class="v3-section-heading"><h2 id="v3-depth-title">In-Depth Reading</h2><a href="/genres/">Explore more <span aria-hidden="true">→</span></a></div>
        <a class="v3-depth-card" href="/genres/"><span class="v3-depth-icon" aria-hidden="true">▤</span><span><strong>Discover your next reading journey</strong><small>Explore genres, themes and the stories that stay with you.</small><em>Reading guide <span aria-hidden="true">↗</span></em></span></a>
      </section>
      <section class="v2-reading-cta" aria-labelledby="v2-reading-title">
        <div><p class="v2-section-eyebrow">STAY IN THE LOOP</p><h2 id="v2-reading-title">Hunmeng’s stories<br /><em>in your corner.</em></h2><p>Discover the latest chapters, new releases and reading news. No email subscription is required.</p></div>
        <div class="v2-reading-actions"><a href={site.contacts.telegramChannel} target="_blank" rel="noopener noreferrer">Follow our updates <span aria-hidden="true">↗</span></a><a href="/news/">Read the latest news <span aria-hidden="true">→</span></a></div>
      </section>

      <div class="v2-bottom-note"><span>{launched ? 'Hunmeng 2.0 · Reading room' : 'Hunmeng 2.0 · Preview edition'}</span><span>Made for readers, built on the existing library.</span></div>
    </div>
  </main>
