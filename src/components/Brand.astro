---
import { site } from '../config/site';
---

<a class="brand" href="/" aria-label={`${site.name} — ${site.tagline}`} title={site.latinName}>
  <span class="brand-emblem" aria-hidden="true">
    <svg viewBox="0 0 52 52" width="44" height="44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="1" y="1" width="50" height="50" rx="15" class="brand-emblem-frame" />
      <path d="M10 15.5c6.8-1.8 12.1-1.1 16 2.2 3.9-3.3 9.2-4 16-2.2v22c-6.7-1.8-12.1-1.1-16 2.2-3.9-3.3-9.3-4-16-2.2v-22Z" class="brand-emblem-book" stroke-width="1.75" stroke-linejoin="round"/>
      <path d="M26 17.7v22M14.5 21.5c3-.4 5.5-.1 7.8 1M37.5 21.5c-3-.4-5.5-.1-7.8 1" class="brand-emblem-page" stroke-width="1.5" stroke-linecap="round"/>
      <path d="m26 7.5 1.15 3.4 3.35 1.1-3.35 1.1L26 16.5l-1.15-3.4-3.35-1.1 3.35-1.1L26 7.5Z" class="brand-emblem-star"/>
    </svg>
  </span>
  <span class="brand-wordmark">
    <span class="brand-title">{site.name}</span>
    <span class="brand-subtitle">{site.tagline}</span>
  </span>
</a>
