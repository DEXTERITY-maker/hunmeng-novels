---
import { site } from '../config/site';
import Brand from '../components/Brand.astro';
import HeaderActions from '../components/HeaderActions.astro';
import { settingsBootstrap } from '../lib/storage';
import '../styles/foundation.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/presentation.css';
import '../styles/interface-motion.css';
import '@fontsource-variable/lora/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/noto-serif/wght.css';
interface Props {
  title: string;
  description?: string;
  reader?: boolean;
  noindex?: boolean;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title, description = site.description, reader = false, noindex = false,
  ogImage, ogImageWidth, ogImageHeight, ogImageAlt, structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url);
const administrative = Astro.url.pathname.startsWith('/admin/');
const socialImage = new URL(ogImage ?? '/images/og-default.png', Astro.site || site.url);
const socialWidth = ogImage ? ogImageWidth : 1200;
const socialHeight = ogImage ? ogImageHeight : 630;
const socialAlt = ogImageAlt ?? `${site.name} — web novel library`;
const socialTitle = `${title} — ${site.name} ${site.tagline}`;
const c = site.colors;
const darkTokens = `--bg:${c.darkBackground};--surface:${c.darkSurface};--ink:${c.darkText};--muted:${c.darkMuted};--accent:${c.darkAccent};--soft:${c.darkSurface};--line:${c.darkBorder};color-scheme:dark`;
const tokens = `:root{--bg:${c.background};--surface:${c.surface};--ink:${c.text};--muted:${c.muted};--accent:${c.accent};--soft:${c.accentSoft};--line:${c.border};color-scheme:light}html[data-theme="dark"]{${darkTokens}}@media(prefers-color-scheme:dark){html[data-theme="system"]{${darkTokens}}}html[data-theme="sepia"]{--bg:${c.sepiaBackground};--surface:${c.sepiaSurface};--ink:${c.sepiaText};--muted:${c.sepiaMuted};--accent:${c.sepiaAccent};--soft:${c.sepiaSurface};--line:${c.sepiaBorder}}`;
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — {site.name} {site.tagline}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content={administrative || Astro.url.pathname === '/account/' ? 'no-referrer' : 'strict-origin-when-cross-origin'} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <script is:inline set:html={settingsBootstrap} />
    {site.features.accounts && Astro.url.pathname === '/' && (
      <script is:inline>
        // Supabase can fall back to its configured Site URL after email confirmation.
        const confirmation = new URLSearchParams(location.search);
        const authCode = confirmation.get('code');
        if (authCode && authCode.length <= 2048) {
          history.replaceState(null, '', '/');
          location.replace('/account/?code=' + encodeURIComponent(authCode));
        }
      </script>
    )}
    {administrative && (
      <script is:inline>
        // Editorial login never consumes OAuth tokens or user-controlled redirect URLs.
        if (location.search || location.hash) history.replaceState(null, '', location.pathname);
      </script>
    )}
    <meta name="theme-color" content="#1d4e42" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.latinName} />
    <meta name="application-name" content={site.latinName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {socialWidth && <meta property="og:image:width" content={String(socialWidth)} />}
    {socialHeight && <meta property="og:image:height" content={String(socialHeight)} />}
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    )}
    <style is:inline set:html={tokens} />
  </head>
  <body class:list={[reader && 'reader-page']}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {!reader && (
      <header class="site-header">
        <div class="header-inner">
          <Brand />
          <nav aria-label="Main navigation">
            {[
              ['/', 'Home'],
              ['/catalog/', 'Catalog'],
              ['/library/', 'Library'],
              ['/news/', 'News'],
            ].map(([url, label]) => (
              <a href={url} aria-current={(url === '/' ? Astro.url.pathname === '/' : (Astro.url.pathname.startsWith(url) || (url === '/catalog/' && Astro.url.pathname.startsWith('/novel/')))) ? 'page' : undefined}>
                {label}
              </a>
            ))}
          </nav>
          <HeaderActions showAccount={!administrative} />
        </div>
      </header>
    )}
    <slot />
    {!reader && (
      <footer class="site-footer">
        <div class="site-footer-inner">
          <div class="site-footer-identity">
            <Brand />
            <p>A calmer corner of the internet for immersive worlds and the next great chapter.</p>
          </div>
          <div class="footer-link-group">
            <h2 id="footer-discover">Discover</h2>
            <nav aria-labelledby="footer-discover">
              <a href="/catalog/">Catalog</a>
              <a href="/genres/">Genres</a>
              <a href="/tags/">Tags</a>
              <a href="/authors/">Authors</a>
              <a href="/updates/">Latest chapters</a>
              <a href="/news/">News</a>
            </nav>
          </div>
          <div class="footer-link-group">
            <h2 id="footer-info">Hunmeng</h2>
            <nav aria-labelledby="footer-info">
              <a href="/library/">My library</a>
              {site.features.accounts && <a href="/account/">Account</a>}
              <a href="/about/">About</a>
              <a href="/rules/">Terms and privacy</a>
              <a href="/contacts/">Contact</a>
              <a href="/rights/">Rights holders</a>
            </nav>
          </div>
        </div>
        <div class="site-footer-bottom">
          <span>© 2026 Hunmeng.</span>
          <span>Read at your own pace.</span>
        </div>
      </footer>
    )}
    <p id="storage-notice" class="storage-notice" role="status" hidden>
      Your browser cannot save data. Progress and settings will last only until you close this page.
    </p>
    <script>
      import { initFormValidation } from '../scripts/form-validation';
      initFormValidation();
      import { repository, applySettings, onStorageChange, STORAGE_KEY } from '../lib/storage';
      const apply = async () => {
        const state = await repository.getState();
        const reader = document.querySelector<HTMLElement>('[data-reader]');
        const novel = reader?.dataset.novel;
        // Progress checkpoints must not repaint a book-specific theme with
        // the shared settings from another novel.
        applySettings((novel && state.novelSettings?.[novel]) || state.settings);
      };
      const showStorageWarning = () => { document.getElementById('storage-notice')!.hidden = false; };
      window.addEventListener('reader:storage-error', showStorageWarning);
      // Detect unavailable storage even when an earlier module saw the failure before
      // this event listener was registered. Never override the in-memory fallback.
      try { window.localStorage.getItem(STORAGE_KEY); } catch { showStorageWarning(); }
      void apply();
      import { initAppearance } from '../scripts/appearance';
      void initAppearance();
      import { initHeader } from '../scripts/header';
      initHeader();
      // Smooth scrolling is an editorial enhancement, not a dependency of the reader,
      // account, admin pages or their scroll/keyboard behaviour.
      if (window.matchMedia('(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
        void import('../scripts/editorial-scroll').then(({ initEditorialScroll }) => {
          initEditorialScroll();
        });
      }
      onStorageChange(() => void apply());
      import { site } from '../config/site';
      if (site.features.accounts) {
        void import('../scripts/account-nav').then(({ initAccountNav }) => initAccountNav());
      }
      // Recover a locally queued, server-verified chapter reward on the next page,
      // without loading Supabase or affecting guest pages when no receipt exists.
      if (site.features.accounts) {
        let pendingRewards = false;
        try { pendingRewards = !!localStorage.getItem('hunmeng-novels:reader-reward-pending:v1'); } catch {}
        if (pendingRewards) {
          void import('../scripts/reader-rewards')
            .then(({ recoverPendingReaderRewards }) => recoverPendingReaderRewards())
            .catch(() => {});
        }
      }
      if (site.features.accounts && site.features.readerSync) {
        // Guest pages do not need the Supabase sync bundle at all.
        let optedIn = false;
        try { optedIn = !!localStorage.getItem('hunmeng-novels:cloud-sync-owner:v1'); } catch {}
        if (optedIn) void import('../lib/sync').then(({ startReaderSync }) => startReaderSync());
      }
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', () => void apply());
    </script>
  </body>
</html>
