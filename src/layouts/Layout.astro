---
import { site } from '../config/site';
import Brand from '../components/Brand.astro';
import { settingsBootstrap } from '../lib/storage';
import '../styles/global.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/noto-serif/wght.css';
interface Props {
  title: string;
  description?: string;
  reader?: boolean;
  noindex?: boolean;
}
const { title, description = site.description, reader = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url);
const c = site.colors;
const darkTokens = `--bg:${c.darkBackground};--surface:${c.darkSurface};--ink:${c.darkText};--muted:${c.darkMuted};--accent:${c.darkAccent};--soft:${c.darkSurface};--line:${c.darkBorder};color-scheme:dark`;
const tokens = `:root{--bg:${c.background};--surface:${c.surface};--ink:${c.text};--muted:${c.muted};--accent:${c.accent};--soft:${c.accentSoft};--line:${c.border};color-scheme:light}html[data-theme="dark"]{${darkTokens}}@media(prefers-color-scheme:dark){html[data-theme="system"]{${darkTokens}}}html[data-theme="sepia"]{--bg:${c.sepiaBackground};--surface:${c.sepiaSurface};--ink:${c.sepiaText};--muted:${c.sepiaMuted};--accent:${c.sepiaAccent};--soft:${c.sepiaSurface};--line:${c.sepiaBorder}}`;
---

<!doctype html>
<html lang="ru" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — {site.name} {site.tagline}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <script is:inline set:html={settingsBootstrap} />
    <meta name="theme-color" content="#1C3455" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.latinName} />
    <meta name="application-name" content={site.latinName} />
    <meta property="og:title" content={`${title} — ${site.name} ${site.tagline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <style is:inline set:html={tokens} />
  </head>
  <body class:list={[reader && 'reader-page']}>
    <a class="skip-link" href="#main">
      К содержимому
    </a>
    {!reader && (
      <header class="site-header">
        <div class="header-inner">
          <Brand />
          <nav aria-label="Основная навигация">
            {[
              ['/', 'Главная'],
              ['/catalog/', 'Каталог'],
              ['/library/', 'Библиотека'],
              ['/news/', 'Новости'],
              ['/account/', 'Аккаунт'],
            ].map(([url, label]) => (
              <a href={url} aria-current={Astro.url.pathname === url ? 'page' : undefined}>
                {label}
              </a>
            ))}
          </nav>
        </div>
      </header>
    )}
    <slot />
    {!reader && (
      <footer class="site-footer">
        <Brand />
        <p>Истории для неспешного чтения.</p>
        <nav aria-label="Информация">
          <a href="/news/">Новости</a>
          <a href="/account/">Аккаунт</a>
          <a href="/about/">О проекте</a>
          <a href="/rules/">Правила</a>
          <a href="/contacts/">Контакты</a>
          <a href="/rights/">Правообладателям</a>
        </nav>
        <p class="fine">Демонстрационные истории написаны специально для проекта.</p>
      </footer>
    )}
    <p id="storage-notice" class="storage-notice" role="status" hidden>
      Браузер не сохраняет данные. Прогресс и настройки доступны только до закрытия страницы.
    </p>
    <script>
      import { repository, applySettings, onStorageChange } from '../lib/storage';
      const apply = async () => applySettings(await repository.getSettings());
      window.addEventListener('reader:storage-error', () => {
        document.getElementById('storage-notice')!.hidden = false;
      });
      void apply();
      onStorageChange(() => void apply());
      import { startReaderSync } from '../lib/sync';
      startReaderSync();
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', () => void apply());
    </script>
  </body>
</html>
