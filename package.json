{
  "name": "hunmeng-novels",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-social-images.mjs",
    "prebuild": "node scripts/prepare-social-images.mjs",
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build && node scripts/audit-build.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "tsc --noEmit -p tsconfig.tests.json && playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/noto-serif": "^5.2.0",
    "astro": "^6.0.0",
    "sharp": "^0.34.5",
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
